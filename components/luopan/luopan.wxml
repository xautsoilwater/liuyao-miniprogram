<view class="yitu">
  <!-- 顶部读数：方位 + 度数 + 山向（借鉴专业罗盘 HUD） -->
  <view class="hud">
    <view class="hud-main">
      <text class="hud-dir">{{headingDir}}</text>
      <text class="hud-deg">{{headingDeg}}°</text>
    </view>
    <view class="hud-sub">
      <text class="hud-mountain">{{mountain}}山</text>
    </view>
  </view>

  <view class="tool-row">
    <view class="tool-btn {{detailOpen ? 'on' : ''}}" bindtap="onToggleDirection">方位</view>
    <view class="tool-btn {{locked ? 'on' : ''}}" bindtap="onToggleLock">{{locked ? '已锁' : '锁定'}}</view>
  </view>

  <view class="direction-dismiss" wx:if="{{detailOpen}}" bindtap="onCloseDirection"></view>

  <view class="direction-card" wx:if="{{detailOpen}}">
    <view class="direction-title">方位助手</view>
    <view class="direction-tabs">
      <view class="direction-tab {{directionTab === 'measure' ? 'on' : ''}}" data-tab="measure" bindtap="onDirectionTab">测向</view>
      <view class="direction-tab {{directionTab === 'symbol' ? 'on' : ''}}" data-tab="symbol" bindtap="onDirectionTab">象意</view>
      <view class="direction-tab {{directionTab === 'guide' ? 'on' : ''}}" wx:if="{{guideAvailable}}" data-tab="guide" bindtap="onDirectionTab">卦引</view>
    </view>
    <view class="direction-grid" wx:if="{{directionTab === 'measure'}}">
      <view class="direction-item">
        <text class="direction-lab">当前向</text>
        <text class="direction-val">{{headingDir}} · {{headingDeg}}° · {{mountain}}山</text>
      </view>
      <view class="direction-item">
        <text class="direction-lab">相反坐向</text>
        <text class="direction-val">{{sitDir}} · {{sitDeg}}° · {{sitMountain}}山</text>
      </view>
      <view class="direction-item">
        <text class="direction-lab">山向范围</text>
        <text class="direction-val">{{mountainRange}}</text>
      </view>
      <view class="direction-item">
        <text class="direction-lab">测量状态</text>
        <text class="direction-val">{{locked ? '朝向已锁定' : stability}}</text>
      </view>
    </view>
    <view class="direction-grid" wx:elif="{{directionTab === 'symbol'}}">
      <view class="direction-item">
        <text class="direction-lab">卦与五行</text>
        <text class="direction-val">{{trigram}}卦 · {{element}}</text>
      </view>
      <view class="direction-item">
        <text class="direction-lab">时令</text>
        <text class="direction-val">{{season}} · {{shichen}}</text>
      </view>
      <view class="direction-item">
        <text class="direction-lab">相邻山向</text>
        <text class="direction-val">{{adjacentMountains}}</text>
      </view>
      <view class="direction-item">
        <text class="direction-lab">传统象意</text>
        <text class="direction-val">{{directionMeaning}}</text>
      </view>
    </view>
    <view class="direction-guide" wx:else>
      <view class="direction-guide-focus">卦象目标：{{guideFocus}} · {{guidePlace}}</view>
      <view class="direction-guide-turn">{{guideTurn}}</view>
      <view class="direction-note">到达目标方向后请结合现场核验，勿只认一个点。</view>
    </view>
    <view class="direction-note" wx:if="{{directionTab !== 'guide'}}">方位用于测向和传统文化参考，不直接判断吉凶。</view>
  </view>

  <view class="dial-stage">
    <view class="halo"></view>

    <view class="auto-plate">
      <view
        class="plate"
        style="transform:rotate({{plateDeg}}deg);-webkit-transform:rotate({{plateDeg}}deg);"
      catchtouchstart="onPlateTouchStart"
      catchtouchmove="onPlateTouchMove"
      catchtouchend="onPlateTouchEnd"
      catchtouchcancel="onPlateTouchEnd"
    >
      <view class="rim rim-outer"></view>
      <view class="rim rim-mid"></view>
      <view class="band-degree"></view>
      <view class="band-zhi"></view>
      <view class="band-gua"></view>

      <view class="ring r-outer"></view>
      <view class="ring r-degree"></view>
      <view class="ring r-zhi"></view>
      <view class="ring r-gua"></view>
      <view class="ring r-core"></view>

      <view class="layer ticks">
        <view
          class="tick {{item.major ? 'major' : ''}} {{item.mid ? 'mid' : ''}}"
          wx:for="{{ticks}}"
          wx:key="deg"
          style="transform: rotate({{item.deg}}deg)"
        ></view>
      </view>

      <view class="layer spokes">
        <view class="spoke" wx:for="{{spokes}}" wx:key="*this" style="transform: rotate({{item}}deg)"></view>
      </view>

      <view class="layer sectors"></view>

      <view class="layer deg-labs">
        <view class="item deg-item" wx:for="{{degreeLabels}}" wx:key="text" style="transform: rotate({{item.deg}}deg)">
          <text class="deg-lab">{{item.text}}</text>
        </view>
      </view>

      <view class="layer dirs">
        <view class="item dir" wx:for="{{dirs}}" wx:key="name" style="transform: rotate({{item.deg}}deg)">
          <text class="dir-lab">{{item.name}}</text>
        </view>
      </view>

      <view class="layer mountains">
        <view class="item mountain" wx:for="{{mountains}}" wx:key="name" style="transform: rotate({{item.deg}}deg)">
          <text class="mountain-lab {{item.cardinal ? 'cardinal' : ''}}">{{item.name}}</text>
        </view>
      </view>

      <view class="layer guas">
        <view class="item gua" wx:for="{{bagua}}" wx:key="name" style="transform: rotate({{item.deg}}deg)">
          <view class="gua-lab tone-{{item.tone}}">
            <view class="gua-bars">
              <view class="bar {{item.lines[2] ? 'yang' : 'yin'}}"></view>
              <view class="bar {{item.lines[1] ? 'yang' : 'yin'}}"></view>
              <view class="bar {{item.lines[0] ? 'yang' : 'yin'}}"></view>
            </view>
            <text class="gua-name">{{item.name}}</text>
            <text class="gua-tip">{{item.tip}}</text>
          </view>
        </view>
      </view>
      </view>
    </view>

    <!-- 固定准星：盘转、线不动 -->
    <view class="sight" aria-hidden="true">
      <view class="sight-v"></view>
      <view class="sight-h"></view>
      <view class="sight-cap">
        <text class="sight-arrow">▲</text>
      </view>
      <view class="sight-bead"></view>
    </view>

    <view class="core">
      <view class="core-ring"></view>
      <view class="taiji breath">
        <view class="half yang"></view>
        <view class="half yin"></view>
        <view class="eye yang-eye"></view>
        <view class="eye yin-eye"></view>
        <view class="dot yang-dot"></view>
        <view class="dot yin-dot"></view>
      </view>
    </view>
  </view>

  <view class="gan-row">
    <view class="gan-item tone-{{item.tone}}" wx:for="{{tiangan}}" wx:key="gan">
      <text class="gan-txt">{{item.gan}}</text>
      <text class="gan-wx">{{item.wx}}</text>
    </view>
  </view>
</view>
