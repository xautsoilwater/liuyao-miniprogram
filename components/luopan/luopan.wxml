<view class="yitu">
  <!-- 顶部读数：方位 + 度数 + 山向（借鉴专业罗盘 HUD） -->
  <view class="hud">
    <view class="hud-main">
      <text class="hud-dir">{{headingDir}}</text>
      <text class="hud-deg">{{headingDeg}}°</text>
    </view>
    <view class="hud-sub">
      <text class="hud-mountain">{{mountain}}山</text>
    </view>
  </view>

  <view class="dial-stage">
    <view class="halo"></view>

    <view class="auto-plate">
      <view
        class="plate"
        style="transform:rotate({{plateDeg}}deg);-webkit-transform:rotate({{plateDeg}}deg);"
      catchtouchstart="onPlateTouchStart"
      catchtouchmove="onPlateTouchMove"
      catchtouchend="onPlateTouchEnd"
      catchtouchcancel="onPlateTouchEnd"
    >
      <view class="rim rim-outer"></view>
      <view class="rim rim-mid"></view>
      <view class="band-degree"></view>
      <view class="band-zhi"></view>
      <view class="band-gua"></view>

      <view class="ring r-outer"></view>
      <view class="ring r-degree"></view>
      <view class="ring r-zhi"></view>
      <view class="ring r-gua"></view>
      <view class="ring r-core"></view>

      <view class="layer ticks">
        <view
          class="tick {{item.major ? 'major' : ''}} {{item.mid ? 'mid' : ''}}"
          wx:for="{{ticks}}"
          wx:key="deg"
          style="transform: rotate({{item.deg}}deg)"
        ></view>
      </view>

      <view class="layer spokes">
        <view class="spoke" wx:for="{{spokes}}" wx:key="*this" style="transform: rotate({{item}}deg)"></view>
      </view>

      <view class="layer sectors"></view>

      <view class="layer deg-labs">
        <view class="item deg-item" wx:for="{{degreeLabels}}" wx:key="text" style="transform: rotate({{item.deg}}deg)">
          <text class="deg-lab">{{item.text}}</text>
        </view>
      </view>

      <view class="layer dirs">
        <view class="item dir" wx:for="{{dirs}}" wx:key="name" style="transform: rotate({{item.deg}}deg)">
          <text class="dir-lab">{{item.name}}</text>
        </view>
      </view>

      <view class="layer mountains">
        <view class="item mountain" wx:for="{{mountains}}" wx:key="name" style="transform: rotate({{item.deg}}deg)">
          <text class="mountain-lab {{item.cardinal ? 'cardinal' : ''}}">{{item.name}}</text>
        </view>
      </view>

      <view class="layer guas">
        <view class="item gua" wx:for="{{bagua}}" wx:key="name" style="transform: rotate({{item.deg}}deg)">
          <view class="gua-lab tone-{{item.tone}}">
            <view class="gua-bars">
              <view class="bar {{item.lines[2] ? 'yang' : 'yin'}}"></view>
              <view class="bar {{item.lines[1] ? 'yang' : 'yin'}}"></view>
              <view class="bar {{item.lines[0] ? 'yang' : 'yin'}}"></view>
            </view>
            <text class="gua-name">{{item.name}}</text>
            <text class="gua-tip">{{item.tip}}</text>
          </view>
        </view>
      </view>
      </view>
    </view>

    <!-- 固定准星：盘转、线不动 -->
    <view class="sight" aria-hidden="true">
      <view class="sight-v"></view>
      <view class="sight-h"></view>
      <view class="sight-cap">
        <text class="sight-arrow">▲</text>
      </view>
      <view class="sight-bead"></view>
    </view>

    <view class="core">
      <view class="core-ring"></view>
      <view class="taiji breath">
        <view class="half yang"></view>
        <view class="half yin"></view>
        <view class="eye yang-eye"></view>
        <view class="eye yin-eye"></view>
        <view class="dot yang-dot"></view>
        <view class="dot yin-dot"></view>
      </view>
    </view>
  </view>

  <view class="wx-row">
    <view class="wx-item tone-{{item.tone}}" wx:for="{{wuxing}}" wx:key="wx">
      <text class="wx-name">{{item.wx}}</text>
    </view>
  </view>
</view>
