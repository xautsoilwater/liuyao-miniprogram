.fig {
  margin: 24rpx 0 28rpx;
}

.fig-stage {
  position: relative;
  min-height: 220rpx;
  padding: 28rpx 12rpx;
  overflow: visible;
  border: 1rpx solid var(--line-strong);
  background:
    radial-gradient(ellipse at 50% 0%, rgba(246, 237, 216, 0.9), transparent 60%),
    rgba(244, 234, 214, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fig-cap {
  margin-top: 12rpx;
  text-align: center;
  font-size: 26rpx;
  letter-spacing: 0.08em;
  color: var(--mist);
  line-height: 1.6;
}

/* taiji */
.taiji {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f4ead6;
  box-shadow: inset 0 0 0 2rpx rgba(20, 15, 12, 0.35);
}
.half { position: absolute; top: 0; width: 50%; height: 100%; }
.yang { left: 0; background: #f4ead6; }
.yin { right: 0; background: #140f0c; }
.eye {
  position: absolute; left: 45rpx; width: 90rpx; height: 90rpx; border-radius: 50%;
}
.eye.top { top: 0; background: #140f0c; }
.eye.bot { bottom: 0; background: #f4ead6; }
.dot {
  position: absolute; left: 75rpx; width: 30rpx; height: 30rpx; border-radius: 50%; z-index: 2;
}
.dot.top { top: 30rpx; background: #f4ead6; }
.dot.bot { bottom: 30rpx; background: #140f0c; }

/* sancai */
.sancai { width: 100%; }
.sc-row {
  display: flex; align-items: center; gap: 12rpx;
  padding: 12rpx 8rpx; border-bottom: 1rpx dashed var(--line);
}
.sc-lab {
  width: 40rpx; color: var(--cinnabar); letter-spacing: 0.1em; font-weight: 600;
}
.sc-row .bar { width: 88rpx; height: 8rpx; }
.sc-row .bar.yang { background: var(--ink); }
.sc-row .bar.yin {
  background: linear-gradient(90deg, var(--ink) 0 42%, transparent 42% 58%, var(--ink) 58% 100%);
}
.sc-yx { margin-left: auto; font-size: 24rpx; color: var(--mist); letter-spacing: 0.08em; }
.sc-row.t { background: rgba(143, 38, 31, 0.04); }
.sc-row.m { background: rgba(122, 98, 64, 0.06); }
.sc-row.b { background: rgba(20, 15, 12, 0.03); }

/* tri / rings */
.tri { display: flex; gap: 12rpx; width: 100%; justify-content: center; }
.tri-item {
  flex: 1; text-align: center; padding: 20rpx 8rpx;
  border: 1rpx solid var(--line-strong);
}
.tri-item .k {
  display: block; font-size: 38rpx; color: var(--cinnabar); letter-spacing: 0.2em; font-weight: 600;
}
.tri-item .v { display: block; margin-top: 8rpx; font-size: 24rpx; color: var(--mist); letter-spacing: 0.08em; }

.rings {
  position: relative; width: 200rpx; height: 200rpx;
}
.rg {
  position: absolute; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  letter-spacing: 0.2em; font-weight: 600;
}
.r1 {
  inset: 30%; background: var(--ink); color: #f4ead6; font-size: 32rpx;
}
.r2 {
  inset: 14%; border: 2rpx solid var(--bronze); color: var(--bronze); font-size: 28rpx;
  background: rgba(244, 234, 214, 0.65);
}
.r3 {
  inset: 0; border: 2rpx solid var(--cinnabar); color: var(--cinnabar); font-size: 26rpx;
}

/* 先天 / 后天卦盘 —— 对标首页 luopan：多层 rim/ring、刻度、辐条、真爻画、宣纸朱砂 */
.lf-disks {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}
.lf-disks.is-compare {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx 12rpx;
}

.lf-disk {
  --yt: 460rpx;
  --ink-deep: #140f0c;
  --cream: #f6eedc;
  --sight: #a03328;
  position: relative;
  width: var(--yt);
}
.lf-disks.is-compare .lf-disk { --yt: 300rpx; }

.lf-halo {
  position: absolute;
  left: -18rpx;
  top: -18rpx;
  width: calc(var(--yt) + 36rpx);
  height: calc(var(--yt) + 36rpx);
  border-radius: 50%;
  background: rgba(122, 98, 64, 0.07);
  pointer-events: none;
}

.lf-plate {
  position: relative;
  width: var(--yt);
  height: var(--yt);
  border-radius: 50%;
  overflow: hidden;
  background: #e6d4b0;
  box-shadow:
    inset 0 0 0 3rpx rgba(20, 15, 12, 0.35),
    inset 0 0 0 12rpx rgba(248, 240, 222, 0.55),
    inset 0 0 0 16rpx rgba(90, 70, 40, 0.22),
    0 0 0 2rpx rgba(70, 52, 28, 0.45),
    0 12rpx 28rpx rgba(20, 15, 12, 0.14);
}

.lf-rim {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.lf-rim.outer { inset: 1.4%; border: 2rpx solid rgba(20, 15, 12, 0.22); }
.lf-rim.mid { inset: 3.4%; border: 1rpx solid rgba(246, 237, 216, 0.55); }

.lf-band {
  position: absolute;
  inset: 20%;
  border-radius: 50%;
  border: 30rpx solid rgba(143, 38, 31, 0.06);
  box-sizing: border-box;
  pointer-events: none;
}
.lf-disks.is-compare .lf-band { border-width: 20rpx; }

.lf-ring {
  position: absolute;
  border-radius: 50%;
  border: 1rpx solid rgba(20, 15, 12, 0.12);
  pointer-events: none;
}
.lf-ring.r-outer { inset: 5%; border-color: rgba(20, 15, 12, 0.2); }
.lf-ring.r-dir { inset: 14%; border-color: rgba(143, 38, 31, 0.22); }
.lf-ring.r-gua { inset: 36%; border-color: rgba(20, 15, 12, 0.12); }
.lf-ring.r-core { inset: 46%; border-color: rgba(143, 38, 31, 0.16); }

.lf-layer {
  position: absolute;
  inset: 0;
  border-radius: 50%;
}

.lf-item {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 0;
  height: 0;
}

.lf-tick {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 2rpx;
  height: calc(var(--yt) / 2 - 8rpx);
  margin-left: -1rpx;
  margin-top: calc(0px - var(--yt) / 2 + 8rpx);
  transform-origin: 50% calc(var(--yt) / 2 - 8rpx);
  background: linear-gradient(to bottom, rgba(20, 15, 12, 0.18) 0, rgba(20, 15, 12, 0.18) 7rpx, transparent 7rpx);
  pointer-events: none;
}
.lf-tick.mid {
  background: linear-gradient(to bottom, rgba(20, 15, 12, 0.32) 0, rgba(20, 15, 12, 0.32) 11rpx, transparent 11rpx);
}
.lf-tick.major {
  width: 3rpx;
  margin-left: -1.5rpx;
  background: linear-gradient(to bottom, rgba(143, 38, 31, 0.55) 0, rgba(143, 38, 31, 0.55) 16rpx, transparent 16rpx);
}

.lf-spoke {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 1rpx;
  height: 28%;
  margin-left: -0.5rpx;
  margin-top: -28%;
  transform-origin: 50% 100%;
  background: rgba(20, 15, 12, 0.12);
  pointer-events: none;
}

.lf-dir-lab {
  position: absolute;
  left: 0;
  top: calc(var(--yt) * -0.43);
  transform: translateX(-50%);
  font-size: 20rpx;
  letter-spacing: 0.16em;
  text-indent: 0.16em;
  color: rgba(143, 38, 31, 0.78);
  font-weight: 700;
  line-height: 1;
}
.lf-disks.is-compare .lf-dir-lab { font-size: 16rpx; }

.lf-gua {
  position: absolute;
  left: 0;
  top: calc(var(--yt) * -0.27);
  width: 88rpx;
  margin-left: -44rpx;
  text-align: center;
  line-height: 1.05;
  --gua: var(--ink-deep);
}
.lf-disks.is-compare .lf-gua {
  width: 64rpx;
  margin-left: -32rpx;
  top: calc(var(--yt) * -0.29);
}

.lf-bars {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  margin: 0 auto 6rpx;
  width: 44rpx;
}
.lf-disks.is-compare .lf-bars { width: 32rpx; gap: 3rpx; margin-bottom: 4rpx; }

.lf-bar {
  width: 44rpx;
  height: 5rpx;
  background: var(--gua);
  border-radius: 1rpx;
}
.lf-disks.is-compare .lf-bar { width: 32rpx; height: 4rpx; }
.lf-bar.is-yin {
  background: linear-gradient(
    to right,
    var(--gua) 0,
    var(--gua) 36%,
    transparent 36%,
    transparent 64%,
    var(--gua) 64%,
    var(--gua) 100%
  );
}

.lf-gua-name {
  display: block;
  font-size: 26rpx;
  letter-spacing: 0.16em;
  text-indent: 0.16em;
  color: var(--gua);
  font-weight: 700;
}
.lf-disks.is-compare .lf-gua-name { font-size: 20rpx; }

.lf-gua-tip {
  display: block;
  margin-top: 2rpx;
  font-size: 16rpx;
  letter-spacing: 0.04em;
  font-weight: 600;
  color: var(--gua);
  opacity: 0.88;
}
.lf-disks.is-compare .lf-gua-tip { font-size: 13rpx; }

.lf-gua-vol {
  display: block;
  margin-top: 2rpx;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--sight);
  font-variant-numeric: tabular-nums;
}
.lf-disks.is-compare .lf-gua-vol { font-size: 14rpx; }

.lf-south {
  position: absolute;
  left: 50%;
  top: 10rpx;
  transform: translateX(-50%);
  color: var(--sight);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  text-shadow: 0 1rpx 0 rgba(250, 243, 228, 0.8);
  z-index: 4;
}
.lf-disks.is-compare .lf-south { font-size: 16rpx; top: 6rpx; }

.lf-core {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 108rpx;
  height: 108rpx;
  margin: -54rpx 0 0 -54rpx;
  border-radius: 50%;
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f0e4c8;
  border: 1rpx solid rgba(20, 15, 12, 0.18);
  box-shadow:
    0 0 0 4rpx rgba(250, 243, 228, 0.45),
    0 0 0 6rpx rgba(143, 38, 31, 0.1);
}
.lf-disks.is-compare .lf-core {
  width: 72rpx;
  height: 72rpx;
  margin: -36rpx 0 0 -36rpx;
}

.lf-taiji {
  position: relative;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--cream);
  box-shadow: inset 0 0 0 2rpx rgba(20, 15, 12, 0.42);
}
.lf-disks.is-compare .lf-taiji { width: 32rpx; height: 32rpx; }
.lf-half { position: absolute; top: 0; width: 50%; height: 100%; }
.lf-half.yang { left: 0; background: var(--cream); }
.lf-half.yin { right: 0; background: var(--ink-deep); }
.lf-eye {
  position: absolute; left: 13rpx; width: 26rpx; height: 26rpx; border-radius: 50%;
}
.lf-disks.is-compare .lf-eye { left: 8rpx; width: 16rpx; height: 16rpx; }
.lf-eye.top { top: 0; background: var(--ink-deep); }
.lf-eye.bot { bottom: 0; background: var(--cream); }
.lf-dot {
  position: absolute; left: 20rpx; width: 12rpx; height: 12rpx; border-radius: 50%; z-index: 2;
}
.lf-disks.is-compare .lf-dot { left: 12rpx; width: 8rpx; height: 8rpx; }
.lf-dot.top { top: 7rpx; background: var(--cream); }
.lf-dot.bot { bottom: 7rpx; background: var(--ink-deep); }

.lf-core-title {
  margin-top: 4rpx;
  font-size: 20rpx;
  letter-spacing: 0.2em;
  text-indent: 0.2em;
  color: var(--sight);
  font-weight: 700;
}
.lf-disks.is-compare .lf-core-title { font-size: 16rpx; margin-top: 2rpx; letter-spacing: 0.12em; }

.lf-legend {
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
  letter-spacing: 0.16em;
  color: rgba(143, 38, 31, 0.78);
}
.lf-disks.is-compare .lf-legend { font-size: 20rpx; margin-top: 8rpx; }

/* yao4 */
.yao4 { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.y4 {
  display: flex; flex-direction: column; align-items: center; gap: 10rpx;
  padding: 16rpx 8rpx; border: 1rpx solid var(--line);
  font-size: 26rpx; letter-spacing: 0.1em;
}
.y4 .yao-bar { width: 100rpx; height: 8rpx; margin: 0; }

/* change */
.chg { display: flex; align-items: center; gap: 20rpx; }
.chg-col { display: flex; flex-direction: column; gap: 10rpx; align-items: center; }
.chg-h { font-size: 26rpx; letter-spacing: 0.2em; color: var(--bronze); margin-bottom: 4rpx; }
.chg-arrow { color: var(--cinnabar); font-size: 38rpx; }
.chg-col .yao-bar { width: 90rpx; height: 8rpx; margin: 0; }

/* coins */
.coins-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
  justify-content: center;
}
.c-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: block;
  box-shadow: 0 6rpx 14rpx rgba(20, 15, 12, 0.14);
}

/* shiying */
.sy { width: 100%; }
.sy-row {
  display: flex; align-items: center; gap: 12rpx;
  padding: 8rpx 4rpx; font-size: 26rpx;
}
.sy-row .yao-bar { width: 120rpx; height: 8rpx; margin: 0; }
.sy-row .tag { width: 48rpx; text-align: center; color: var(--cinnabar); font-size: 24rpx; }
.sy-row .tag.mid { color: var(--bronze); }

/* liuqin */
.lq {
  position: relative; width: 260rpx; height: 220rpx;
}
.lq-core {
  position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: var(--ink); color: #f4ead6;
  display: flex; align-items: center; justify-content: center;
  letter-spacing: 0.12em; font-size: 30rpx;
}
.lq-item {
  position: absolute; font-size: 26rpx; letter-spacing: 0.08em; color: var(--ink-soft);
}
.lq-item.a { top: 8rpx; left: 50%; transform: translateX(-50%); color: var(--cinnabar); }
.lq-item.b { top: 50%; right: 8rpx; transform: translateY(-50%); }
.lq-item.c { bottom: 8rpx; left: 50%; transform: translateX(-50%); }
.lq-item.d { top: 50%; left: 8rpx; transform: translateY(-50%); }
.lq-item.e { top: 28rpx; right: 36rpx; }

/* liushen */
.ls {
  display: flex; flex-wrap: wrap; justify-content: center; gap: 10rpx;
  font-size: 26rpx; letter-spacing: 0.08em;
}
.ls text {
  padding: 8rpx 12rpx; border: 1rpx solid var(--line-strong);
}
.ls-arrow {
  width: 100%; text-align: center; margin-top: 8rpx;
  font-size: 24rpx; color: var(--mist); letter-spacing: 0.12em;
}

/* wangshuai */
.ws { display: flex; gap: 10rpx; }
.ws-i {
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  border: 1rpx solid var(--line-strong);
  font-size: 28rpx; color: var(--mist);
}
.ws-i.on {
  background: var(--ink); color: #f4ead6; border-color: var(--ink);
}

/* fushen */
.fu { text-align: center; }
.fu-row {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  font-size: 28rpx;
}
.fu-row .yao-bar { width: 100rpx; height: 8rpx; margin: 0; }
.fu-under {
  margin-top: 12rpx; font-size: 26rpx; color: var(--cinnabar); letter-spacing: 0.12em;
}

/* he-chong */
.hc { display: flex; gap: 14rpx; }
.hc-chip {
  padding: 16rpx 22rpx; border: 1rpx solid var(--line-strong);
  letter-spacing: 0.2em; font-size: 30rpx; color: var(--cinnabar);
}

/* path */
.path {
  display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8rpx;
  font-size: 28rpx; letter-spacing: 0.16em; color: var(--bronze);
}
.path .sep { color: var(--line-strong); }

.fallback .gua-big { font-size: 80rpx; color: var(--bronze); }
.muted { color: var(--mist); }
