.fig {
  margin: 24rpx 0 28rpx;
}

.fig-stage {
  position: relative;
  min-height: 220rpx;
  padding: 28rpx 12rpx;
  overflow: visible;
  border: 1rpx solid var(--line-strong);
  background:
    radial-gradient(ellipse at 50% 0%, rgba(246, 237, 216, 0.9), transparent 60%),
    rgba(244, 234, 214, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}
.fig-stage.is-disk {
  padding: 52rpx 28rpx 40rpx;
}

.fig-cap {
  margin-top: 12rpx;
  text-align: center;
  font-size: 26rpx;
  letter-spacing: 0.08em;
  color: var(--mist);
  line-height: 1.6;
}

/* taiji */
.taiji {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f4ead6;
  box-shadow: inset 0 0 0 2rpx rgba(20, 15, 12, 0.35);
}
.half { position: absolute; top: 0; width: 50%; height: 100%; }
.taiji .yang { left: 0; background: #f4ead6; }
.taiji .yin { right: 0; background: #140f0c; }
.eye {
  position: absolute; left: 45rpx; width: 90rpx; height: 90rpx; border-radius: 50%;
}
.eye.top { top: 0; background: #140f0c; }
.eye.bot { bottom: 0; background: #f4ead6; }
.dot {
  position: absolute; left: 75rpx; width: 30rpx; height: 30rpx; border-radius: 50%; z-index: 2;
}
.dot.top { top: 30rpx; background: #f4ead6; }
.dot.bot { bottom: 30rpx; background: #140f0c; }

/* sancai */
.sancai { width: 100%; }
.sc-row {
  display: flex; align-items: center; gap: 12rpx;
  padding: 12rpx 8rpx; border-bottom: 1rpx dashed var(--line);
}
.sc-lab {
  width: 40rpx; color: var(--cinnabar); letter-spacing: 0.1em; font-weight: 600;
}
.sc-row .bar { width: 88rpx; height: 8rpx; }
.sc-row .bar.yang { background: var(--ink); }
.sc-row .bar.yin {
  background: linear-gradient(90deg, var(--ink) 0 42%, transparent 42% 58%, var(--ink) 58% 100%);
}
.sc-yx { margin-left: auto; font-size: 24rpx; color: var(--mist); letter-spacing: 0.08em; }
.sc-row.t { background: rgba(143, 38, 31, 0.04); }
.sc-row.m { background: rgba(122, 98, 64, 0.06); }
.sc-row.b { background: rgba(20, 15, 12, 0.03); }

/* tri / rings */
.tri { display: flex; gap: 12rpx; width: 100%; justify-content: center; }
.tri-item {
  flex: 1; text-align: center; padding: 20rpx 8rpx;
  border: 1rpx solid var(--line-strong);
}
.tri-item .k {
  display: block; font-size: 38rpx; color: var(--cinnabar); letter-spacing: 0.2em; font-weight: 600;
}
.tri-item .v { display: block; margin-top: 8rpx; font-size: 24rpx; color: var(--mist); letter-spacing: 0.08em; }

.rings {
  position: relative; width: 200rpx; height: 200rpx;
}
.rg {
  position: absolute; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  letter-spacing: 0.2em; font-weight: 600;
}
.r1 {
  inset: 30%; background: var(--ink); color: #f4ead6; font-size: 32rpx;
}
.r2 {
  inset: 14%; border: 2rpx solid var(--bronze); color: var(--bronze); font-size: 28rpx;
  background: rgba(244, 234, 214, 0.65);
}
.r3 {
  inset: 0; border: 2rpx solid var(--cinnabar); color: var(--cinnabar); font-size: 26rpx;
}

/* 先天 / 后天卦盘 —— 对标首页 luopan：多层 rim/ring、刻度、辐条、真爻画、宣纸朱砂 */
.lf-disks {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}
.lf-disks.is-compare {
  flex-direction: column;
  align-items: center;
  gap: 48rpx;
}

.lf-disk {
  /* 单盘直径 = 界面/视口宽 70%（750rpx 设计宽 → 525rpx） */
  --yt: 70vw;
  --ink-deep: #140f0c;
  --cream: #f6eedc;
  --sight: #a03328;
  position: relative;
  width: var(--yt);
  overflow: visible;
}

.lf-halo {
  position: absolute;
  left: -18rpx;
  top: -18rpx;
  width: calc(var(--yt) + 36rpx);
  height: calc(var(--yt) + 36rpx);
  border-radius: 50%;
  background: rgba(122, 98, 64, 0.07);
  pointer-events: none;
}

.lf-plate {
  position: relative;
  width: var(--yt);
  height: var(--yt);
  border-radius: 50%;
  overflow: hidden;
  background: #e6d4b0;
  box-shadow:
    inset 0 0 0 3rpx rgba(20, 15, 12, 0.35),
    inset 0 0 0 12rpx rgba(248, 240, 222, 0.55),
    inset 0 0 0 16rpx rgba(90, 70, 40, 0.22),
    0 0 0 2rpx rgba(70, 52, 28, 0.45),
    0 12rpx 28rpx rgba(20, 15, 12, 0.14);
}

.lf-rim {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.lf-rim.outer { inset: 1.4%; border: 2rpx solid rgba(20, 15, 12, 0.22); }
.lf-rim.mid { inset: 3.4%; border: 1rpx solid rgba(246, 237, 216, 0.55); }

.lf-band {
  position: absolute;
  inset: 10%;
  border-radius: 50%;
  border: 16rpx solid rgba(143, 38, 31, 0.06);
  box-sizing: border-box;
  pointer-events: none;
}

.lf-ring {
  position: absolute;
  border-radius: 50%;
  border: 1rpx solid rgba(20, 15, 12, 0.12);
  pointer-events: none;
}
.lf-ring.r-outer { inset: 5%; border-color: rgba(20, 15, 12, 0.2); }
.lf-ring.r-dir { inset: 13%; border-color: rgba(143, 38, 31, 0.22); }
.lf-ring.r-gua { inset: 27%; border-color: rgba(20, 15, 12, 0.12); }
.lf-ring.r-core { inset: 41%; border-color: rgba(143, 38, 31, 0.16); }

.lf-layer {
  position: absolute;
  inset: 0;
  border-radius: 50%;
}

.lf-item {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 0;
  height: 0;
}

.lf-tick {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 2rpx;
  height: calc(var(--yt) / 2 - 8rpx);
  margin-left: -1rpx;
  margin-top: calc(0px - var(--yt) / 2 + 8rpx);
  transform-origin: 50% calc(var(--yt) / 2 - 8rpx);
  background: linear-gradient(to bottom, rgba(20, 15, 12, 0.18) 0, rgba(20, 15, 12, 0.18) 7rpx, transparent 7rpx);
  pointer-events: none;
}
.lf-tick.mid {
  background: linear-gradient(to bottom, rgba(20, 15, 12, 0.32) 0, rgba(20, 15, 12, 0.32) 11rpx, transparent 11rpx);
}
.lf-tick.major {
  width: 3rpx;
  margin-left: -1.5rpx;
  background: linear-gradient(to bottom, rgba(143, 38, 31, 0.55) 0, rgba(143, 38, 31, 0.55) 16rpx, transparent 16rpx);
}

.lf-spoke {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 1rpx;
  height: 34%;
  margin-left: -0.5rpx;
  margin-top: -34%;
  transform-origin: 50% 100%;
  background: rgba(20, 15, 12, 0.12);
  pointer-events: none;
}

/* 东南西北在盘外正立，不占内环 */
.lf-dirs {
  position: absolute;
  left: 0;
  top: 0;
  width: var(--yt);
  height: var(--yt);
  pointer-events: none;
  z-index: 6;
  overflow: visible;
}
.lf-dir-lab {
  position: absolute;
  font-size: 28rpx;
  letter-spacing: 0.18em;
  color: rgba(143, 38, 31, 0.82);
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}
.lf-dir-lab.deg-0 { left: 50%; top: 0; transform: translate(-50%, calc(-100% - 28rpx)); }
.lf-dir-lab.deg-180 { left: 50%; bottom: 0; transform: translate(-50%, calc(100% + 12rpx)); }
.lf-dir-lab.deg-270 { left: 0; top: 50%; transform: translate(calc(-100% - 14rpx), -50%); }
.lf-dir-lab.deg-90 { right: 0; top: 50%; transform: translate(calc(100% + 14rpx), -50%); }

.lf-gua {
  position: absolute;
  left: 0;
  top: calc(var(--yt) * -0.385);
  width: 132rpx;
  margin-left: -66rpx;
  text-align: center;
  line-height: 1.15;
  --gua: var(--ink-deep);
}

.lf-bars {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7rpx;
  margin: 0 auto 12rpx;
  width: 58rpx;
}

.lf-bar {
  width: 58rpx;
  height: 7rpx;
  background: var(--gua);
  border-radius: 1rpx;
}
.lf-bar.is-yin {
  background: linear-gradient(
    to right,
    var(--gua) 0,
    var(--gua) 36%,
    transparent 36%,
    transparent 64%,
    var(--gua) 64%,
    var(--gua) 100%
  );
}

.lf-gua-name {
  display: block;
  font-size: 34rpx;
  letter-spacing: 0.14em;
  text-indent: 0.14em;
  color: var(--gua);
  font-weight: 700;
}

.lf-gua-meta {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 10rpx;
  margin-top: 8rpx;
  white-space: nowrap;
}

.lf-gua-tip {
  font-size: 22rpx;
  letter-spacing: 0.06em;
  font-weight: 600;
  color: var(--gua);
  opacity: 0.9;
}

.lf-gua-vol {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--sight);
  font-variant-numeric: tabular-nums;
}

.lf-south {
  position: absolute;
  left: 50%;
  top: 0;
  transform: translate(-50%, calc(-100% - 4rpx));
  color: var(--sight);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  text-shadow: 0 1rpx 0 rgba(250, 243, 228, 0.8);
  z-index: 7;
}

.lf-core {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 84rpx;
  height: 84rpx;
  margin: -42rpx 0 0 -42rpx;
  border-radius: 50%;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0e4c8;
  border: 1rpx solid rgba(20, 15, 12, 0.18);
  box-shadow:
    0 0 0 4rpx rgba(250, 243, 228, 0.45),
    0 0 0 6rpx rgba(143, 38, 31, 0.1);
}

.lf-taiji {
  position: relative;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--cream);
  box-shadow: inset 0 0 0 2rpx rgba(20, 15, 12, 0.42);
}
.lf-half { position: absolute; top: 0; width: 50%; height: 100%; }
.lf-half.yang { left: 0; background: var(--cream); }
.lf-half.yin { right: 0; background: var(--ink-deep); }
.lf-eye {
  position: absolute; left: 15rpx; width: 32rpx; height: 32rpx; border-radius: 50%;
}
.lf-eye.top { top: 0; background: var(--ink-deep); }
.lf-eye.bot { bottom: 0; background: var(--cream); }
.lf-dot {
  position: absolute; left: 24rpx; width: 14rpx; height: 14rpx; border-radius: 50%; z-index: 2;
}
.lf-dot.top { top: 9rpx; background: var(--cream); }
.lf-dot.bot { bottom: 9rpx; background: var(--ink-deep); }

.lf-legend {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  letter-spacing: 0.16em;
  color: rgba(143, 38, 31, 0.78);
}

/* yao4 */
.yao4 { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.y4 {
  display: flex; flex-direction: column; align-items: center; gap: 10rpx;
  padding: 16rpx 8rpx; border: 1rpx solid var(--line);
  font-size: 26rpx; letter-spacing: 0.1em;
}
.y4 .yao-bar { width: 100rpx; height: 8rpx; margin: 0; }

/* change */
.chg { display: flex; align-items: center; gap: 20rpx; }
.chg-col { display: flex; flex-direction: column; gap: 10rpx; align-items: center; }
.chg-h { font-size: 26rpx; letter-spacing: 0.2em; color: var(--bronze); margin-bottom: 4rpx; }
.chg-arrow { color: var(--cinnabar); font-size: 38rpx; }
.chg-col .yao-bar { width: 90rpx; height: 8rpx; margin: 0; }

/* coins */
.coins-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
  justify-content: center;
}
.c-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: block;
  box-shadow: 0 6rpx 14rpx rgba(20, 15, 12, 0.14);
}

/* shiying */
.sy { width: 100%; }
.sy-row {
  display: flex; align-items: center; gap: 12rpx;
  padding: 8rpx 4rpx; font-size: 26rpx;
}
.sy-row .yao-bar { width: 120rpx; height: 8rpx; margin: 0; }
.sy-row .tag { width: 48rpx; text-align: center; color: var(--cinnabar); font-size: 24rpx; }
.sy-row .tag.mid { color: var(--bronze); }

/* liuqin */
.lq {
  position: relative; width: 260rpx; height: 220rpx;
}
.lq-core {
  position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: var(--ink); color: #f4ead6;
  display: flex; align-items: center; justify-content: center;
  letter-spacing: 0.12em; font-size: 30rpx;
}
.lq-item {
  position: absolute; font-size: 26rpx; letter-spacing: 0.08em; color: var(--ink-soft);
}
.lq-item.a { top: 8rpx; left: 50%; transform: translateX(-50%); color: var(--cinnabar); }
.lq-item.b { top: 50%; right: 8rpx; transform: translateY(-50%); }
.lq-item.c { bottom: 8rpx; left: 50%; transform: translateX(-50%); }
.lq-item.d { top: 50%; left: 8rpx; transform: translateY(-50%); }
.lq-item.e { top: 28rpx; right: 36rpx; }

/* liushen */
.ls {
  display: flex; flex-wrap: wrap; justify-content: center; gap: 10rpx;
  font-size: 26rpx; letter-spacing: 0.08em;
}
.ls text {
  padding: 8rpx 12rpx; border: 1rpx solid var(--line-strong);
}
.ls-arrow {
  width: 100%; text-align: center; margin-top: 8rpx;
  font-size: 24rpx; color: var(--mist); letter-spacing: 0.12em;
}

/* wangshuai */
.ws { display: flex; gap: 10rpx; }
.ws-i {
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  border: 1rpx solid var(--line-strong);
  font-size: 28rpx; color: var(--mist);
}
.ws-i.on {
  background: var(--ink); color: #f4ead6; border-color: var(--ink);
}

/* fushen */
.fu { text-align: center; }
.fu-row {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  font-size: 28rpx;
}
.fu-row .yao-bar { width: 100rpx; height: 8rpx; margin: 0; }
.fu-under {
  margin-top: 12rpx; font-size: 26rpx; color: var(--cinnabar); letter-spacing: 0.12em;
}

/* he-chong */
.hc { display: flex; gap: 14rpx; }
.hc-chip {
  padding: 16rpx 22rpx; border: 1rpx solid var(--line-strong);
  letter-spacing: 0.2em; font-size: 30rpx; color: var(--cinnabar);
}

/* path */
.path {
  display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8rpx;
  font-size: 28rpx; letter-spacing: 0.16em; color: var(--bronze);
}
.path .sep { color: var(--line-strong); }

.fallback .gua-big { font-size: 80rpx; color: var(--bronze); }
.muted { color: var(--mist); }

.yao-bar {
  display: block;
  width: 120rpx;
  height: 10rpx;
  margin: 0 auto;
  position: relative;
  box-sizing: border-box;
}
.yao-bar.yang { background: var(--ink); }
.yao-bar.yin {
  background: linear-gradient(
    90deg,
    var(--ink) 0%,
    var(--ink) 42%,
    transparent 42%,
    transparent 58%,
    var(--ink) 58%,
    var(--ink) 100%
  );
}
.yao-bar.moving::after {
  content: "";
  position: absolute;
  right: -18rpx;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  margin-top: -5rpx;
  border-radius: 50%;
  background: var(--cinnabar);
}
.yao-bar.on {
  box-shadow: 0 0 0 2rpx rgba(143, 38, 31, 0.28);
}

.bg-grid {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 12rpx 8rpx;
}
.bg-cell {
  text-align: center;
  padding: 10rpx 4rpx 12rpx;
  border: 1rpx solid var(--line);
}
.bg-bars { width: 36rpx; gap: 4rpx; margin-bottom: 8rpx; }
.bg-bars .lf-bar { width: 36rpx; height: 4rpx; }
.bg-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
}
.bg-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--mist);
  letter-spacing: 0.04em;
}

.wx-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx;
}
.wx-i {
  width: 56rpx;
  height: 56rpx;
  border: 1rpx solid var(--line-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--cinnabar);
  font-weight: 700;
}
.wx-arr { font-size: 22rpx; color: var(--bronze); letter-spacing: 0.08em; }

.nw {
  width: 100%;
  display: flex;
  justify-content: center;
  gap: 48rpx;
}
.nw-col, .hg-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.nw-h, .hg-h {
  font-size: 28rpx;
  letter-spacing: 0.2em;
  color: var(--bronze);
  font-weight: 700;
}
.nw-t { font-size: 22rpx; color: var(--mist); letter-spacing: 0.08em; }
.nw-col .yao-bar, .hg-col .yao-bar { width: 90rpx; height: 8rpx; margin: 0; }

.hg { display: flex; align-items: center; justify-content: center; gap: 20rpx; }
.hg-arr { color: var(--cinnabar); font-size: 38rpx; }

.path.wrap { row-gap: 10rpx; }
