.fig {
  margin: 24rpx 0 28rpx;
}

.fig-stage {
  position: relative;
  min-height: 220rpx;
  padding: 28rpx 20rpx;
  border: 1rpx solid var(--line-strong);
  background:
    radial-gradient(ellipse at 50% 0%, rgba(246, 237, 216, 0.9), transparent 60%),
    rgba(244, 234, 214, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fig-cap {
  margin-top: 12rpx;
  text-align: center;
  font-size: 26rpx;
  letter-spacing: 0.08em;
  color: var(--mist);
  line-height: 1.6;
}

/* taiji */
.taiji {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f4ead6;
  box-shadow: inset 0 0 0 2rpx rgba(20, 15, 12, 0.35);
}
.half { position: absolute; top: 0; width: 50%; height: 100%; }
.yang { left: 0; background: #f4ead6; }
.yin { right: 0; background: #140f0c; }
.eye {
  position: absolute; left: 45rpx; width: 90rpx; height: 90rpx; border-radius: 50%;
}
.eye.top { top: 0; background: #140f0c; }
.eye.bot { bottom: 0; background: #f4ead6; }
.dot {
  position: absolute; left: 75rpx; width: 30rpx; height: 30rpx; border-radius: 50%; z-index: 2;
}
.dot.top { top: 30rpx; background: #f4ead6; }
.dot.bot { bottom: 30rpx; background: #140f0c; }

/* sancai */
.sancai { width: 100%; }
.sc-row {
  display: flex; align-items: center; gap: 12rpx;
  padding: 12rpx 8rpx; border-bottom: 1rpx dashed var(--line);
}
.sc-lab {
  width: 40rpx; color: var(--cinnabar); letter-spacing: 0.1em; font-weight: 600;
}
.sc-row .bar { width: 88rpx; height: 8rpx; }
.sc-row .bar.yang { background: var(--ink); }
.sc-row .bar.yin {
  background: linear-gradient(90deg, var(--ink) 0 42%, transparent 42% 58%, var(--ink) 58% 100%);
}
.sc-yx { margin-left: auto; font-size: 24rpx; color: var(--mist); letter-spacing: 0.08em; }
.sc-row.t { background: rgba(143, 38, 31, 0.04); }
.sc-row.m { background: rgba(122, 98, 64, 0.06); }
.sc-row.b { background: rgba(20, 15, 12, 0.03); }

/* tri / rings */
.tri { display: flex; gap: 12rpx; width: 100%; justify-content: center; }
.tri-item {
  flex: 1; text-align: center; padding: 20rpx 8rpx;
  border: 1rpx solid var(--line-strong);
}
.tri-item .k {
  display: block; font-size: 38rpx; color: var(--cinnabar); letter-spacing: 0.2em; font-weight: 600;
}
.tri-item .v { display: block; margin-top: 8rpx; font-size: 24rpx; color: var(--mist); letter-spacing: 0.08em; }

.rings {
  position: relative; width: 200rpx; height: 200rpx;
}
.rg {
  position: absolute; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  letter-spacing: 0.2em; font-weight: 600;
}
.r1 {
  inset: 30%; background: var(--ink); color: #f4ead6; font-size: 32rpx;
}
.r2 {
  inset: 14%; border: 2rpx solid var(--bronze); color: var(--bronze); font-size: 28rpx;
  background: rgba(244, 234, 214, 0.65);
}
.r3 {
  inset: 0; border: 2rpx solid var(--cinnabar); color: var(--cinnabar); font-size: 26rpx;
}

/* bagua (通用简版) */
.bagua {
  position: relative; width: 260rpx; height: 260rpx;
}
.bg-item {
  position: absolute; left: 50%; top: 50%; width: 0; height: 0;
}
.bg-in {
  position: absolute; left: 0; top: -110rpx;
  transform: translateX(-50%);
  font-size: 28rpx; letter-spacing: 0.06em; color: var(--ink); white-space: nowrap;
}
.bg-core {
  position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
  font-size: 26rpx; color: var(--cinnabar); letter-spacing: 0.12em;
}

/* 先天八卦图 & 后天八卦图 */
.xiantian-bagua, .houtian-bagua {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0;
}

.bagua-circle {
  position: relative;
  width: 560rpx;
  height: 560rpx;
  border: 3rpx solid var(--bronze);
  border-radius: 50%;
  background: 
    radial-gradient(circle at center, rgba(244, 234, 214, 0.9) 0%, rgba(244, 234, 214, 0.6) 60%, transparent 100%);
  box-shadow: 
    inset 0 0 0 1rpx rgba(122, 98, 64, 0.15),
    0 8rpx 24rpx rgba(20, 15, 12, 0.08);
}

.gua-pos {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  z-index: 2;
}

.gua-symbol {
  font-size: 44rpx;
  color: var(--ink);
  line-height: 1;
  font-weight: 500;
}

.gua-name {
  font-size: 30rpx;
  color: var(--cinnabar);
  letter-spacing: 0.12em;
  font-weight: 600;
  margin-top: 2rpx;
}

.gua-info {
  font-size: 22rpx;
  color: var(--mist);
  letter-spacing: 0.06em;
  white-space: nowrap;
}

/* 八方位定位 */
.pos-s { top: 8rpx; left: 50%; transform: translateX(-50%); }
.pos-n { bottom: 8rpx; left: 50%; transform: translateX(-50%); }
.pos-e { top: 50%; right: 8rpx; transform: translateY(-50%); }
.pos-w { top: 50%; left: 8rpx; transform: translateY(-50%); }
.pos-ne { top: 66rpx; right: 66rpx; }
.pos-se { bottom: 66rpx; right: 66rpx; }
.pos-sw { bottom: 66rpx; left: 66rpx; }
.pos-nw { top: 66rpx; left: 66rpx; }

/* 先天八卦对待连线 */
.duidai-line {
  position: absolute;
  background: rgba(143, 38, 31, 0.15);
  z-index: 1;
}

.line-ns {
  left: 50%;
  top: 90rpx;
  bottom: 90rpx;
  width: 1rpx;
  transform: translateX(-50%);
}

.line-ew {
  top: 50%;
  left: 90rpx;
  right: 90rpx;
  height: 1rpx;
  transform: translateY(-50%);
}

.line-nese {
  width: 1rpx;
  height: 360rpx;
  top: 50%;
  left: 50%;
  transform-origin: center;
  transform: translate(-50%, -50%) rotate(45deg);
}

.line-nwsw {
  width: 1rpx;
  height: 360rpx;
  top: 50%;
  left: 50%;
  transform-origin: center;
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* 后天八卦流行箭头（简洁提示） */
.flow-arrow {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid var(--bronze);
  border-left: none;
  border-bottom: none;
  z-index: 1;
  opacity: 0.3;
}

.arrow-spring {
  top: 50%;
  right: 140rpx;
  transform: translateY(-50%) rotate(45deg);
}

.arrow-summer {
  top: 140rpx;
  left: 50%;
  transform: translateX(-50%) rotate(-45deg);
}

.arrow-autumn {
  top: 50%;
  left: 140rpx;
  transform: translateY(-50%) rotate(-135deg);
}

.arrow-winter {
  bottom: 140rpx;
  left: 50%;
  transform: translateX(-50%) rotate(135deg);
}

/* 中心标识 */
.center-mark {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 16rpx 20rpx;
  background: rgba(244, 234, 214, 0.95);
  border: 2rpx solid var(--line-strong);
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(20, 15, 12, 0.08);
}

.center-title {
  font-size: 32rpx;
  color: var(--cinnabar);
  letter-spacing: 0.2em;
  font-weight: 600;
}

.center-sub {
  font-size: 22rpx;
  color: var(--bronze);
  letter-spacing: 0.12em;
}

/* 先天后天对照表 */
.bagua-table {
  width: 100%;
  border: 2rpx solid var(--line-strong);
  background: rgba(244, 234, 214, 0.3);
}

.table-header {
  display: grid;
  grid-template-columns: 1.2fr 1fr 1fr;
  background: var(--ink);
  padding: 16rpx 8rpx;
}

.th {
  text-align: center;
  font-size: 26rpx;
  letter-spacing: 0.12em;
  color: #f4ead6;
  font-weight: 600;
}

.table-row {
  display: grid;
  grid-template-columns: 1.2fr 1fr 1fr;
  border-top: 1rpx solid var(--line);
  padding: 14rpx 8rpx;
  align-items: center;
}

.table-row:nth-child(odd) {
  background: rgba(244, 234, 214, 0.2);
}

.td {
  text-align: center;
  font-size: 26rpx;
  letter-spacing: 0.08em;
  color: var(--ink-soft);
}

.td-gua {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.td-gua .sym {
  font-size: 32rpx;
  color: var(--ink);
}

.td-xian {
  color: var(--cinnabar);
  font-weight: 500;
}

.td-hou {
  color: var(--bronze);
  font-weight: 500;
}

/* yao4 */
.yao4 { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.y4 {
  display: flex; flex-direction: column; align-items: center; gap: 10rpx;
  padding: 16rpx 8rpx; border: 1rpx solid var(--line);
  font-size: 26rpx; letter-spacing: 0.1em;
}
.y4 .yao-bar { width: 100rpx; height: 8rpx; margin: 0; }

/* change */
.chg { display: flex; align-items: center; gap: 20rpx; }
.chg-col { display: flex; flex-direction: column; gap: 10rpx; align-items: center; }
.chg-h { font-size: 26rpx; letter-spacing: 0.2em; color: var(--bronze); margin-bottom: 4rpx; }
.chg-arrow { color: var(--cinnabar); font-size: 38rpx; }
.chg-col .yao-bar { width: 90rpx; height: 8rpx; margin: 0; }

/* coins */
.coins-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
  justify-content: center;
}
.c-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: block;
  box-shadow: 0 6rpx 14rpx rgba(20, 15, 12, 0.14);
}

/* shiying */
.sy { width: 100%; }
.sy-row {
  display: flex; align-items: center; gap: 12rpx;
  padding: 8rpx 4rpx; font-size: 26rpx;
}
.sy-row .yao-bar { width: 120rpx; height: 8rpx; margin: 0; }
.sy-row .tag { width: 48rpx; text-align: center; color: var(--cinnabar); font-size: 24rpx; }
.sy-row .tag.mid { color: var(--bronze); }

/* liuqin */
.lq {
  position: relative; width: 260rpx; height: 220rpx;
}
.lq-core {
  position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: var(--ink); color: #f4ead6;
  display: flex; align-items: center; justify-content: center;
  letter-spacing: 0.12em; font-size: 30rpx;
}
.lq-item {
  position: absolute; font-size: 26rpx; letter-spacing: 0.08em; color: var(--ink-soft);
}
.lq-item.a { top: 8rpx; left: 50%; transform: translateX(-50%); color: var(--cinnabar); }
.lq-item.b { top: 50%; right: 8rpx; transform: translateY(-50%); }
.lq-item.c { bottom: 8rpx; left: 50%; transform: translateX(-50%); }
.lq-item.d { top: 50%; left: 8rpx; transform: translateY(-50%); }
.lq-item.e { top: 28rpx; right: 36rpx; }

/* liushen */
.ls {
  display: flex; flex-wrap: wrap; justify-content: center; gap: 10rpx;
  font-size: 26rpx; letter-spacing: 0.08em;
}
.ls text {
  padding: 8rpx 12rpx; border: 1rpx solid var(--line-strong);
}
.ls-arrow {
  width: 100%; text-align: center; margin-top: 8rpx;
  font-size: 24rpx; color: var(--mist); letter-spacing: 0.12em;
}

/* wangshuai */
.ws { display: flex; gap: 10rpx; }
.ws-i {
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  border: 1rpx solid var(--line-strong);
  font-size: 28rpx; color: var(--mist);
}
.ws-i.on {
  background: var(--ink); color: #f4ead6; border-color: var(--ink);
}

/* fushen */
.fu { text-align: center; }
.fu-row {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  font-size: 28rpx;
}
.fu-row .yao-bar { width: 100rpx; height: 8rpx; margin: 0; }
.fu-under {
  margin-top: 12rpx; font-size: 26rpx; color: var(--cinnabar); letter-spacing: 0.12em;
}

/* he-chong */
.hc { display: flex; gap: 14rpx; }
.hc-chip {
  padding: 16rpx 22rpx; border: 1rpx solid var(--line-strong);
  letter-spacing: 0.2em; font-size: 30rpx; color: var(--cinnabar);
}

/* path */
.path {
  display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8rpx;
  font-size: 28rpx; letter-spacing: 0.16em; color: var(--bronze);
}
.path .sep { color: var(--line-strong); }

.fallback .gua-big { font-size: 80rpx; color: var(--bronze); }
.muted { color: var(--mist); }

/* ═══════════════════════════════════════════════════════════════
   先天/后天八卦盘：对标罗盘质感
   多层同心圆、刻度、真爻画、宣纸底、朱砂墨色
   ══════════════════════════════════════════════════════════════ */

.bagua-disk {
  --disk-size: 420rpx;
  position: relative;
  width: var(--disk-size);
  height: var(--disk-size);
  margin: 0 auto;
}

.disk-halo {
  position: absolute;
  left: -20rpx;
  top: -20rpx;
  width: calc(var(--disk-size) + 40rpx);
  height: calc(var(--disk-size) + 40rpx);
  border-radius: 50%;
  background: rgba(122, 98, 64, 0.05);
  pointer-events: none;
  z-index: 0;
}

.disk-plate {
  position: relative;
  width: var(--disk-size);
  height: var(--disk-size);
  border-radius: 50%;
  overflow: visible;
  background: #e6d4b0;
  box-shadow:
    inset 0 0 0 2rpx rgba(20, 15, 12, 0.3),
    inset 0 0 0 12rpx rgba(248, 240, 222, 0.5),
    inset 0 0 0 16rpx rgba(90, 70, 40, 0.18),
    0 0 0 2rpx rgba(70, 52, 28, 0.4),
    0 12rpx 28rpx rgba(20, 15, 12, 0.12);
}

.disk-rim {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 1;
}
.disk-rim-outer {
  inset: 1%;
  border: 2rpx solid rgba(20, 15, 12, 0.2);
}
.disk-rim-mid {
  inset: 2.5%;
  border: 1rpx solid rgba(246, 237, 216, 0.5);
}

.disk-band {
  position: absolute;
  border-radius: 50%;
  z-index: 1;
  background: transparent;
  box-sizing: border-box;
  pointer-events: none;
}
.disk-band-gua {
  inset: 22%;
  border: 32rpx solid rgba(143, 38, 31, 0.04);
}

.disk-ring {
  position: absolute;
  border-radius: 50%;
  border: 1rpx solid rgba(20, 15, 12, 0.1);
  pointer-events: none;
  z-index: 2;
}
.disk-ring.disk-r-outer { inset: 3.5%; border-color: rgba(20, 15, 12, 0.18); }
.disk-ring.disk-r-gua { inset: 34%; border-color: rgba(143, 38, 31, 0.18); }
.disk-ring.disk-r-core { inset: 42%; border-color: rgba(20, 15, 12, 0.1); }

.disk-layer {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  z-index: 3;
}

.disk-tick {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 1rpx;
  height: calc(var(--disk-size) / 2 - 6rpx);
  margin-left: -0.5rpx;
  margin-top: calc(0px - var(--disk-size) / 2 + 6rpx);
  transform-origin: 50% calc(var(--disk-size) / 2 - 6rpx);
  background: linear-gradient(to bottom, rgba(20, 15, 12, 0.14) 0, rgba(20, 15, 12, 0.14) 5rpx, transparent 5rpx);
  pointer-events: none;
}
.disk-tick.major {
  width: 2rpx;
  margin-left: -1rpx;
  background: linear-gradient(to bottom, rgba(143, 38, 31, 0.4) 0, rgba(143, 38, 31, 0.4) 10rpx, transparent 10rpx);
}

.disk-spoke {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 1rpx;
  height: 22%;
  margin-left: -0.5rpx;
  margin-top: -22%;
  transform-origin: 50% 100%;
  background: rgba(20, 15, 12, 0.1);
  pointer-events: none;
}

.disk-dir-item {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 0;
  height: 0;
}
.disk-dir-lab {
  position: absolute;
  left: 0;
  top: -164rpx;
  transform: translateX(-50%);
  font-size: 18rpx;
  letter-spacing: 0.12em;
  color: rgba(143, 38, 31, 0.65);
  font-weight: 600;
  line-height: 1;
}

.disk-gua-item {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 0;
  height: 0;
}
.disk-gua-content {
  position: absolute;
  left: 0;
  top: -90rpx;
  width: 72rpx;
  margin-left: -36rpx;
  text-align: center;
  line-height: 1.05;
  --gua: var(--ink);
}
.disk-gua-content.tone-li,
.disk-gua-content.tone-kun,
.disk-gua-content.tone-dui,
.disk-gua-content.tone-qian,
.disk-gua-content.tone-kan,
.disk-gua-content.tone-gen,
.disk-gua-content.tone-zhen,
.disk-gua-content.tone-xun { --gua: var(--ink); }

.disk-gua-bars {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3rpx;
  margin: 0 auto 5rpx;
  width: 36rpx;
}
.disk-bar {
  width: 36rpx;
  height: 4rpx;
  background: var(--gua);
  border-radius: 1rpx;
}
.disk-bar.yin {
  background: linear-gradient(
    to right,
    var(--gua) 0,
    var(--gua) 36%,
    transparent 36%,
    transparent 64%,
    var(--gua) 64%,
    var(--gua) 100%
  );
}
.disk-gua-name {
  display: block;
  font-size: 22rpx;
  letter-spacing: 0.14em;
  text-indent: 0.14em;
  color: var(--gua);
  font-weight: 700;
}
.disk-gua-tip {
  display: block;
  margin-top: 2rpx;
  font-size: 15rpx;
  letter-spacing: 0.06em;
  font-weight: 600;
  opacity: 0.85;
  color: var(--gua);
}

.disk-center {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 100rpx;
  height: 100rpx;
  margin: -50rpx 0 0 -50rpx;
  border-radius: 50%;
  z-index: 7;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.disk-center-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: #f0e4c8;
  border: 1rpx solid rgba(20, 15, 12, 0.16);
  box-shadow:
    0 0 0 4rpx rgba(250, 243, 228, 0.4),
    0 0 0 6rpx rgba(143, 38, 31, 0.08),
    inset 0 0 0 1rpx rgba(246, 237, 216, 0.6);
}
.disk-taiji {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f4ead6;
  box-shadow: inset 0 0 0 2rpx rgba(20, 15, 12, 0.35);
  z-index: 2;
}
.disk-taiji .half { position: absolute; top: 0; width: 50%; height: 100%; }
.disk-taiji .yang { left: 0; background: #f4ead6; }
.disk-taiji .yin { right: 0; background: #140f0c; }
.disk-taiji .eye {
  position: absolute; left: 19rpx; width: 38rpx; height: 38rpx; border-radius: 50%;
}
.disk-taiji .yang-eye { top: 0; background: #140f0c; }
.disk-taiji .yin-eye { bottom: 0; background: #f4ead6; }
.disk-taiji .dot {
  position: absolute; left: 30rpx; width: 14rpx; height: 14rpx; border-radius: 50%; z-index: 2;
}
.disk-taiji .yang-dot { top: 14rpx; background: #f4ead6; }
.disk-taiji .yin-dot { bottom: 14rpx; background: #140f0c; }

.disk-label {
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  transform: translateX(-50%);
  font-size: 19rpx;
  letter-spacing: 0.2em;
  text-indent: 0.2em;
  color: rgba(143, 38, 31, 0.75);
  font-weight: 700;
  z-index: 8;
  pointer-events: none;
}

/* 先后天对照：两盘并陈 */
.bagua-compare {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 24rpx;
  width: 100%;
}
.compare-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.compare-disk.mini {
  --disk-size: 280rpx;
}
.compare-disk.mini .disk-gua-content {
  top: -60rpx;
  width: 56rpx;
  margin-left: -28rpx;
}
.compare-disk.mini .disk-gua-bars {
  width: 28rpx;
  gap: 2rpx;
}
.compare-disk.mini .disk-bar {
  width: 28rpx;
  height: 3rpx;
}
.compare-disk.mini .disk-gua-name {
  font-size: 19rpx;
}
.compare-disk.mini .disk-gua-tip {
  display: none;
}
