.head {
  text-align: center;
  margin-bottom: 20rpx;
  animation: rise 0.55s ease both;
}

.gua-name {
  margin: 18rpx 0 8rpx;
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 58rpx;
  letter-spacing: 0.32em;
  text-indent: 0.32em;
  font-weight: 400;
  color: var(--ink);
}

.gua-meta {
  color: var(--ink-soft);
  font-size: 28rpx;
  letter-spacing: 0.12em;
  margin-top: 4rpx;
}

.q { margin-top: 10rpx; }

.pan-board {
  border: 1rpx solid var(--line-strong);
  background: linear-gradient(180deg, rgba(250, 246, 234, 0.92), rgba(232, 220, 196, 0.78));
  padding: 18rpx 10rpx 14rpx;
  margin-bottom: 16rpx;
  animation: rise 0.65s ease 0.05s both;
  box-shadow: inset 0 0 0 8rpx rgba(250, 246, 234, 0.35);
  position: relative;
}

.pan-heads {
  display: grid;
  grid-template-columns: 1.55fr 1fr;
  gap: 8rpx;
  margin-bottom: 12rpx;
  padding: 0 4rpx;
}

.ph {
  text-align: center;
  padding: 8rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.ph-lab {
  display: block;
  font-size: 24rpx;
  letter-spacing: 0.28em;
  color: var(--bronze);
}

.ph-name {
  display: block;
  margin-top: 4rpx;
  font-size: 30rpx;
  letter-spacing: 0.12em;
  font-weight: 600;
}

.pan-row {
  display: grid;
  grid-template-columns: 0.7fr 0.7fr 1.15fr 0.45fr 1.05fr 0.95fr 0.85fr;
  gap: 2rpx;
  align-items: center;
  text-align: center;
  font-size: 24rpx;
  min-height: 56rpx;
  padding: 10rpx 2rpx;
  border-bottom: 1rpx solid rgba(23, 18, 14, 0.08);
  box-sizing: border-box;
}

.pan-head {
  color: var(--bronze);
  border-bottom: 1rpx solid var(--line-strong);
  min-height: 44rpx;
  font-size: 24rpx;
  letter-spacing: 0.04em;
}

.pan-row.moving {
  background: var(--cinnabar-soft);
  color: var(--cinnabar);
}

.pan-row.kong { opacity: 0.72; }

.c-yao,
.c-byao {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 24rpx;
}
.c-yao {
  /* 爻画居中，右侧固定动符栏，静爻也占位，六行竖向对齐 */
  display: grid;
  grid-template-columns: 1fr 28rpx;
  align-items: center;
  column-gap: 4rpx;
  padding: 0 2rpx;
}
.c-yao .yao-bar,
.c-byao .yao-bar {
  margin: 0;
  justify-self: center;
}
.c-yao .yao-mark {
  width: 28rpx;
  margin: 0;
  padding: 0;
  text-align: center;
  font-size: 24rpx;
  line-height: 1;
  color: var(--cinnabar);
  font-weight: 600;
  letter-spacing: 0;
}
/* 排盘只用 ○ / ×，关掉全局动爻圆点，避免叠标 */
.pan-board .yao-bar.moving::after {
  display: none;
}
.c-role { color: var(--cinnabar); font-weight: 600; }
.c-byao {
  border-left: 1rpx dashed rgba(23, 18, 14, 0.12);
  min-height: 100%;
  padding-left: 4rpx;
}
.muted-dash {
  color: var(--mist);
  letter-spacing: 0;
  border-left: 1rpx dashed rgba(23, 18, 14, 0.12);
}
.c-bqin {
  font-size: 22rpx;
  color: var(--ink-soft);
}

.block {
  padding: 8rpx 0 20rpx;
  border-top: 1rpx solid var(--line);
}

.block-title {
  letter-spacing: 0.28em;
  color: var(--bronze);
  font-size: 26rpx;
  margin: 14rpx 0 10rpx;
}

.block-line,
.change-line {
  font-size: 28rpx;
  color: var(--mist);
  padding: 6rpx 0;
  line-height: 1.7;
}

.change-line { color: var(--cinnabar); }

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.chip {
  font-size: 24rpx;
  padding: 6rpx 12rpx;
  border: 1rpx solid var(--line-strong);
  color: var(--ink-soft);
}

.guide {
  margin-top: 8rpx;
  padding: 24rpx 18rpx 12rpx;
  border: 1rpx solid var(--line-strong);
  background: rgba(244, 234, 214, 0.55);
}

.guide-head {
  text-align: center;
  margin-bottom: 18rpx;
}

.guide-title {
  margin-top: 12rpx;
  font-size: 34rpx;
  letter-spacing: 0.2em;
  font-weight: 600;
}

.guide-sec {
  padding: 16rpx 0;
  border-top: 1rpx solid var(--line);
}

.guide-sec-title {
  font-size: 28rpx;
  letter-spacing: 0.16em;
  color: var(--cinnabar);
  font-weight: 600;
  margin-bottom: 10rpx;
}

.guide-item {
  font-size: 28rpx;
  color: var(--ink-soft);
  line-height: 1.85;
  text-align: justify;
  margin-bottom: 10rpx;
  letter-spacing: 0.02em;
}

.footer-actions {
  display: flex;
  gap: 16rpx;
  margin: 20rpx 0 8rpx;
}

.half { flex: 1; }

@keyframes rise {
  from { opacity: 0; transform: translateY(14rpx); }
  to { opacity: 1; transform: translateY(0); }
}
