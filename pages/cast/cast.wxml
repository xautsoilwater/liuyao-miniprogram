<view
  class="page cast has-fixed-footer"
  bindtouchstart="onSwipeTouchStart"
  bindtouchend="onSwipeTouchEnd"
>
  <nav-back />
  <view class="section-head">
    <view class="title-zh cast-title">卜卦</view>
    <view class="subtitle cast-subtitle">六次成爻 · 自下而上</view>
  </view>

  <view class="mode-row">
    <view class="mode {{mode==='shake'?'on':''}}" data-mode="shake" bindtap="setMode">摇铜钱</view>
    <view class="mode {{mode==='manual'?'on':''}}" data-mode="manual" bindtap="setMode">手记爻象</view>
  </view>

  <view class="stage" wx:if="{{mode==='shake'}}">
    <view class="stage-head">
      <text class="seal-tag">第 {{step < 6 ? step + 1 : 6}} 爻</text>
      <text class="muted">{{step}} / 6</text>
    </view>
    <button class="btn-primary cast-shake-slot" bindtap="shake" disabled="{{shaking || finished}}">
      <view class="shell-inset" aria-hidden="true"></view>
      <text class="shell-label">{{finished ? '六爻已成' : shaking ? '摇卦中…' : '摇铜钱'}}</text>
    </button>
    <view class="stage-live">
      <view class="coin-stage">
        <view class="shaker-stage {{shaking ? 'is-shaking' : ''}}" aria-hidden="true">
          <view class="shaker-vessel">
            <svg class="shaker-svg" viewBox="0 0 90 120" width="62" height="82">
              <defs>
                <radialGradient id="shellBodyWx" cx="45%" cy="40%" r="60%">
                  <stop offset="0%" stop-color="#4a3622" />
                  <stop offset="50%" stop-color="#312215" />
                  <stop offset="85%" stop-color="#1f140c" />
                  <stop offset="100%" stop-color="#120b06" />
                </radialGradient>
                <linearGradient id="shellGoldWx" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#eddba4" />
                  <stop offset="50%" stop-color="#b88d3d" />
                  <stop offset="100%" stop-color="#f5e7bf" />
                </linearGradient>
                <radialGradient id="shellHoleWx" cx="50%" cy="40%" r="55%">
                  <stop offset="0%" stop-color="#2a1d12" />
                  <stop offset="70%" stop-color="#120c08" />
                  <stop offset="100%" stop-color="#050302" />
                </radialGradient>
                <radialGradient id="shellCoinGlintWx" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#ffe8a3" />
                  <stop offset="50%" stop-color="#c99738" stop-opacity="0.8" />
                  <stop offset="100%" stop-color="#c99738" stop-opacity="0" />
                </radialGradient>
              </defs>
              <path d="M 22 22 C 10 38, 8 82, 17 104 C 25 116, 65 116, 73 104 C 82 82, 80 38, 68 22 Z" fill="#0d0805" opacity="0.6" />
              <path d="M 23 20 C 11 36, 9 80, 18 102 C 26 114, 64 114, 72 102 C 81 80, 79 36, 67 20 Z" fill="url(#shellBodyWx)" stroke="#1a110a" stroke-width="1.8" />
              <ellipse cx="45" cy="20" rx="22" ry="9" fill="#18100a" stroke="url(#shellGoldWx)" stroke-width="1.4" />
              <ellipse cx="45" cy="20.5" rx="18" ry="6" fill="url(#shellHoleWx)" />
              <ellipse class="shell-coin-glint" cx="45" cy="20.5" rx="10" ry="4" fill="url(#shellCoinGlintWx)" />
              <path d="M 20 32 C 18 42, 16 56, 15 70 C 15 82, 18 94, 23 103" fill="none" stroke="url(#shellGoldWx)" stroke-width="0.8" opacity="0.45" />
              <path d="M 70 32 C 72 42, 74 56, 75 70 C 75 82, 72 94, 67 103" fill="none" stroke="url(#shellGoldWx)" stroke-width="0.8" opacity="0.45" />
              <line x1="17" y1="44" x2="22" y2="46" stroke="url(#shellGoldWx)" stroke-width="0.7" opacity="0.4" />
              <line x1="15" y1="62" x2="21" y2="63" stroke="url(#shellGoldWx)" stroke-width="0.7" opacity="0.4" />
              <line x1="15" y1="80" x2="21" y2="79" stroke="url(#shellGoldWx)" stroke-width="0.7" opacity="0.4" />
              <line x1="73" y1="44" x2="68" y2="46" stroke="url(#shellGoldWx)" stroke-width="0.7" opacity="0.4" />
              <line x1="75" y1="62" x2="69" y2="63" stroke="url(#shellGoldWx)" stroke-width="0.7" opacity="0.4" />
              <line x1="75" y1="80" x2="69" y2="79" stroke="url(#shellGoldWx)" stroke-width="0.7" opacity="0.4" />
              <polygon points="45,30 55,38 53,52 45,55 37,52 35,38" fill="rgba(255,240,200,0.06)" stroke="url(#shellGoldWx)" stroke-width="1.2" />
              <polygon points="45,57 55,65 54,80 45,84 36,80 35,65" fill="rgba(255,240,200,0.08)" stroke="url(#shellGoldWx)" stroke-width="1.4" />
              <polygon points="45,85 54,92 50,103 45,106 40,103 36,92" fill="rgba(255,240,200,0.05)" stroke="url(#shellGoldWx)" stroke-width="1.2" />
              <polygon points="35,38 37,52 24,56 22,40" fill="none" stroke="url(#shellGoldWx)" stroke-width="0.9" opacity="0.7" />
              <polygon points="55,38 53,52 66,56 68,40" fill="none" stroke="url(#shellGoldWx)" stroke-width="0.9" opacity="0.7" />
              <polygon points="37,52 35,65 36,80 23,80 23,64 24,56" fill="none" stroke="url(#shellGoldWx)" stroke-width="0.9" opacity="0.7" />
              <polygon points="53,52 55,65 54,80 67,80 67,64 66,56" fill="none" stroke="url(#shellGoldWx)" stroke-width="0.9" opacity="0.7" />
              <polygon points="36,80 45,85 40,103 28,99 23,80" fill="none" stroke="url(#shellGoldWx)" stroke-width="0.9" opacity="0.7" />
              <polygon points="54,80 45,85 50,103 62,99 67,80" fill="none" stroke="url(#shellGoldWx)" stroke-width="0.9" opacity="0.7" />
              <circle cx="45" cy="70" r="5" fill="#8f261f" opacity="0.92" />
              <circle cx="45" cy="70" r="4.2" fill="none" stroke="url(#shellGoldWx)" stroke-width="0.6" opacity="0.8" />
              <text x="45" y="72.6" font-size="5" fill="#faeed7" font-weight="bold" text-anchor="middle" font-family="serif">易</text>
              <path d="M 45 32 L 45 104" stroke="url(#shellGoldWx)" stroke-width="0.8" opacity="0.35" stroke-dasharray="2,2" />
            </svg>
          </view>
        </view>
        <view class="coins {{shaking ? 'shake' : ''}}">
          <view
            wx:for="{{coinSlots}}"
            wx:key="*this"
            class="coin {{displayCoins[item] === 'yin' ? 'yin' : (displayCoins[item] === 'yang' ? 'yang' : 'yang idle')}}"
          >
            <view class="coin-shadow"></view>
            <view class="coin-body">
              <image class="coin-face coin-obverse" src="/assets/coins/qianlong-yang.jpg" mode="aspectFit" />
              <image class="coin-face coin-reverse" src="/assets/coins/qianlong-yin.jpg" mode="aspectFit" />
            </view>
          </view>
        </view>
        <view class="result-line">
          <block wx:if="{{current}}">
            <view class="yao-bar lg {{current.yinYang ? 'yang' : 'yin'}} {{current.changing ? 'moving' : ''}}"></view>
            <view class="yao-label">{{current.type}}<text class="mark">{{current.mark}}</text></view>
          </block>
        </view>
      </view>
      <view class="gua-side">
        <view class="gua-lab">卦象</view>
        <view class="gua-lines">
          <view class="gua-slot" wx:for="{{guaLines}}" wx:key="index">
            <view
              class="yao-bar xl {{item.filled ? (item.yinYang ? 'yang' : 'yin') : 'empty'}} {{item.changing ? 'moving' : ''}}"
            ></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="stage" wx:else>
    <view class="stage-head">
      <text class="seal-tag">第 {{step < 6 ? step + 1 : 6}} 爻</text>
      <text class="muted">{{step}} / 6</text>
    </view>
    <view class="progress-row">
      <view class="progress-bead {{step > item ? 'on' : ''}}" wx:for="{{progressSlots}}" wx:key="*this"></view>
    </view>
    <view class="manual-live">
      <view class="manual-left">
        <view class="manual-col-head">按实点选（字阳背阴）</view>
        <view class="manual-grid">
          <view class="manual-item" wx:for="{{manualOptions}}" wx:key="key" data-key="{{item.key}}" bindtap="pickManual">
            <view class="yao-bar {{item.score === 9 || item.score === 7 ? 'yang' : 'yin'}} {{item.score === 9 || item.score === 6 ? 'moving' : ''}}"></view>
            <view class="manual-lab">{{item.label}}</view>
          </view>
        </view>
      </view>
      <view class="manual-right">
        <view class="manual-col-head gua-col-head">成卦卦象</view>
        <view class="gua-side">
          <view class="gua-lines">
            <view class="gua-slot" wx:for="{{guaLines}}" wx:key="index">
              <view
                class="yao-bar xl {{item.filled ? (item.yinYang ? 'yang' : 'yin') : 'empty'}} {{item.changing ? 'moving' : ''}}"
              ></view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

</view>

<view class="footer-actions">
  <block wx:if="{{finished}}">
    <button class="btn-ghost half" bindtap="onBack">返回</button>
    <button class="btn-primary half" bindtap="submit">排卦</button>
  </block>
  <block wx:elif="{{mode === 'shake'}}">
    <button class="btn-ghost half" bindtap="onBack">返回</button>
    <button class="btn-primary half" bindtap="submit" disabled>排卦</button>
  </block>
  <block wx:else>
    <button class="btn-ghost half" bindtap="onBack">返回</button>
    <button class="btn-primary half" bindtap="undoLast" disabled="{{step === 0}}">
      {{step ? '撤回一爻' : '请选择爻象'}}
    </button>
  </block>
</view>
