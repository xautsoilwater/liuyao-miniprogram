  <view class="stage" wx:else>
    <view class="stage-head">
      <text class="seal-tag">第 {{step < 6 ? step + 1 : 6}} 爻</text>
      <text class="muted">{{step}} / 6</text>
    </view>
    <view class="progress-row">
      <view class="progress-bead {{step > item ? 'on' : ''}}" wx:for="{{progressSlots}}" wx:key="*this"></view>
    </view>
    <view class="manual-live">
      <view class="manual-left">
        <view class="manual-col-head">按实点选（字阳背阴）</view>
        <view class="manual-grid">
          <view class="manual-item" wx:for="{{manualOptions}}" wx:key="key" data-key="{{item.key}}" bindtap="pickManual">
            <view class="yao-bar {{item.score === 9 || item.score === 7 ? 'yang' : 'yin'}} {{item.score === 9 || item.score === 6 ? 'moving' : ''}}"></view>
            <view class="manual-lab">{{item.label}}</view>
          </view>
        </view>
      </view>
      <view class="manual-right">
        <view class="manual-col-head gua-col-head">成卦卦象</view>
        <view class="gua-side">
          <view class="gua-lines">
            <view class="gua-slot" wx:for="{{guaLines}}" wx:key="index">
              <view
                class="yao-bar xl {{item.filled ? (item.yinYang ? 'yang' : 'yin') : 'empty'}} {{item.changing ? 'moving' : ''}}"
              ></view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

</view>

<view class="footer-actions">
  <block wx:if="{{finished}}">
    <button class="btn-ghost half" bindtap="onBack">返回</button>
    <button class="btn-primary half" bindtap="submit">排卦</button>
  </block>
  <block wx:elif="{{mode === 'shake'}}">
    <button class="btn-ghost half" bindtap="onBack">返回</button>
    <button class="btn-primary half" bindtap="submit" disabled>排卦</button>
  </block>
  <block wx:else>
    <button class="btn-ghost half" bindtap="onBack">返回</button>
    <button class="btn-primary half" bindtap="undoLast" disabled="{{step === 0}}">
      {{step ? '撤回一爻' : '请选择爻象'}}
    </button>
  </block>
</view>
