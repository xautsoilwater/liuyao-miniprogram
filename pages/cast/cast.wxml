<view
  class="page cast has-fixed-footer"
  bindtouchstart="onSwipeTouchStart"
  bindtouchend="onSwipeTouchEnd"
>
  <nav-back />
  <view class="section-head">
    <view class="title-zh cast-title">卜卦</view>
    <view class="subtitle cast-subtitle">六次成爻 · 自下而上</view>
  </view>

  <view class="mode-row">
    <view class="mode {{mode==='shake'?'on':''}}" data-mode="shake" bindtap="setMode">摇铜钱</view>
    <view class="mode {{mode==='manual'?'on':''}}" data-mode="manual" bindtap="setMode">手记爻象</view>
  </view>

  <view class="stage" wx:if="{{mode==='shake'}}">
    <view class="stage-head">
      <text class="seal-tag">第 {{step < 6 ? step + 1 : 6}} 爻</text>
      <text class="muted">{{step}} / 6</text>
    </view>
    <button class="btn-primary cast-shake-slot" bindtap="shake" disabled="{{shaking || finished}}">
      <view class="shell-inset" aria-hidden="true"></view>
      <text class="shell-label">{{finished ? '六爻已成' : shaking ? '摇卦中…' : '摇铜钱'}}</text>
    </button>
    <view class="stage-live">
      <view class="coin-stage">
        <view class="shaker-stage {{shaking ? 'is-shaking' : ''}}" aria-hidden="true">
          <view class="shaker-vessel">
            <svg class="shaker-svg" viewBox="0 0 140 88" width="138" height="88">
              <defs>
                <radialGradient id="shellBodyWx" cx="48%" cy="46%" r="58%">
                  <stop offset="0%" stop-color="#4a3622" />
                  <stop offset="45%" stop-color="#312215" />
                  <stop offset="82%" stop-color="#1f140c" />
                  <stop offset="100%" stop-color="#120b06" />
                </radialGradient>
                <linearGradient id="shellGoldWx" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#eddba4" />
                  <stop offset="50%" stop-color="#b88d3d" />
                  <stop offset="100%" stop-color="#f5e7bf" />
                </linearGradient>
                <radialGradient id="shellHoleWx" cx="45%" cy="50%" r="55%">
                  <stop offset="0%" stop-color="#2a1d12" />
                  <stop offset="70%" stop-color="#120c08" />
                  <stop offset="100%" stop-color="#050302" />
                </radialGradient>
                <radialGradient id="shellCoinGlintWx" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#ffe8a3" />
                  <stop offset="50%" stop-color="#c99738" stop-opacity="0.8" />
                  <stop offset="100%" stop-color="#c99738" stop-opacity="0" />
                </radialGradient>
              </defs>
              <!-- 横卧龟甲底层沉淀投影 -->
              <path d="M 16 44 C 16 18, 58 8, 114 20 C 128 24, 136 36, 132 48 C 126 64, 110 77, 70 79 C 30 80, 16 66, 16 44 Z" fill="#0d0805" opacity="0.65" />
              <!-- 龟身横甲主轮廓 -->
              <path d="M 18 44 C 18 19, 58 10, 112 22 C 126 26, 134 37, 130 48 C 124 62, 108 75, 70 77 C 31 78, 18 65, 18 44 Z" fill="url(#shellBodyWx)" stroke="#1a110a" stroke-width="2.2" />
              <!-- 侧前出纳龟口（右侧微倾纳币金口） -->
              <ellipse cx="116" cy="42" rx="12" ry="23" transform="rotate(12 116 42)" fill="#18100a" stroke="url(#shellGoldWx)" stroke-width="1.8" />
              <ellipse cx="116" cy="42" rx="9.5" ry="19" transform="rotate(12 116 42)" fill="url(#shellHoleWx)" />
              <ellipse class="shell-coin-glint" cx="116" cy="42" rx="6.5" ry="13" transform="rotate(12 116 42)" fill="url(#shellCoinGlintWx)" />
              <!-- 横向灵龟背甲骨线（左右裙缘流线） -->
              <path d="M 30 30 C 48 21, 82 20, 104 28" fill="none" stroke="url(#shellGoldWx)" stroke-width="1" opacity="0.5" />
              <path d="M 30 60 C 48 68, 82 69, 104 62" fill="none" stroke="url(#shellGoldWx)" stroke-width="1" opacity="0.5" />
              <!-- 裙边放射骨节 -->
              <line x1="42" y1="24" x2="46" y2="31" stroke="url(#shellGoldWx)" stroke-width="0.8" opacity="0.45" />
              <line x1="68" y1="21" x2="69" y2="28" stroke="url(#shellGoldWx)" stroke-width="0.8" opacity="0.45" />
              <line x1="92" y1="23" x2="89" y2="30" stroke="url(#shellGoldWx)" stroke-width="0.8" opacity="0.45" />
              <line x1="42" y1="65" x2="46" y2="58" stroke="url(#shellGoldWx)" stroke-width="0.8" opacity="0.45" />
              <line x1="68" y1="68" x2="69" y2="61" stroke="url(#shellGoldWx)" stroke-width="0.8" opacity="0.45" />
              <line x1="92" y1="66" x2="89" y2="59" stroke="url(#shellGoldWx)" stroke-width="0.8" opacity="0.45" />
              <!-- 横向中央三块主脊板 -->
              <polygon points="28,44 38,33 52,35 56,44 52,53 38,55" fill="rgba(255,240,200,0.05)" stroke="url(#shellGoldWx)" stroke-width="1.1" />
              <polygon points="56,44 64,30 82,30 90,44 82,58 64,58" fill="rgba(255,240,200,0.08)" stroke="url(#shellGoldWx)" stroke-width="1.4" />
              <polygon points="90,44 96,32 107,34 110,43 107,52 96,54" fill="rgba(255,240,200,0.05)" stroke="url(#shellGoldWx)" stroke-width="1.1" />
              <!-- 上肋侧板 -->
              <polygon points="38,33 52,35 60,23 44,23" fill="none" stroke="url(#shellGoldWx)" stroke-width="0.9" opacity="0.65" />
              <polygon points="64,30 82,30 88,19 59,19" fill="none" stroke="url(#shellGoldWx)" stroke-width="0.9" opacity="0.65" />
              <polygon points="82,30 96,32 103,23 88,19" fill="none" stroke="url(#shellGoldWx)" stroke-width="0.9" opacity="0.65" />
              <!-- 下肋侧板 -->
              <polygon points="38,55 52,53 60,65 44,65" fill="none" stroke="url(#shellGoldWx)" stroke-width="0.9" opacity="0.65" />
              <polygon points="64,58 82,58 88,69 59,69" fill="none" stroke="url(#shellGoldWx)" stroke-width="0.9" opacity="0.65" />
              <polygon points="82,58 96,54 103,65 88,69" fill="none" stroke="url(#shellGoldWx)" stroke-width="0.9" opacity="0.65" />
              <!-- 中央朱砂「易」道火漆神印 -->
              <circle cx="73" cy="44" r="8" fill="#8f261f" opacity="0.94" />
              <circle cx="73" cy="44" r="6.6" fill="none" stroke="url(#shellGoldWx)" stroke-width="0.8" opacity="0.85" />
              <text x="73" y="47.6" font-size="8" fill="#faeed7" font-weight="bold" text-anchor="middle" font-family="serif">易</text>
              <!-- 横向脊背金虚线 -->
              <path d="M 26 44 L 109 44" stroke="url(#shellGoldWx)" stroke-width="0.8" opacity="0.3" stroke-dasharray="2,2" />
            </svg>
          </view>
        </view>
        <view class="coins {{shaking ? 'shake' : ''}}">
          <view
            wx:for="{{coinSlots}}"
            wx:key="*this"
            class="coin {{displayCoins[item] === 'yin' ? 'yin' : (displayCoins[item] === 'yang' ? 'yang' : 'yang idle')}}"
          >
            <view class="coin-shadow"></view>
            <view class="coin-body">
              <image class="coin-face coin-obverse" src="/assets/coins/qianlong-yang.jpg" mode="aspectFit" />
              <image class="coin-face coin-reverse" src="/assets/coins/qianlong-yin.jpg" mode="aspectFit" />
            </view>
          </view>
        </view>
        <view class="result-line">
          <block wx:if="{{current}}">
            <view class="yao-bar lg {{current.yinYang ? 'yang' : 'yin'}} {{current.changing ? 'moving' : ''}}"></view>
            <view class="yao-label">{{current.type}}<text class="mark">{{current.mark}}</text></view>
          </block>
        </view>
      </view>
      <view class="gua-side">
        <view class="gua-lab">卦象</view>
        <view class="gua-lines">
          <view class="gua-slot" wx:for="{{guaLines}}" wx:key="index">
            <view
              class="yao-bar xl {{item.filled ? (item.yinYang ? 'yang' : 'yin') : 'empty'}} {{item.changing ? 'moving' : ''}}"
            ></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="stage" wx:else>
    <view class="stage-head">
      <text class="seal-tag">第 {{step < 6 ? step + 1 : 6}} 爻</text>
      <text class="muted">{{step}} / 6</text>
    </view>
    <view class="progress-row">
      <view class="progress-bead {{step > item ? 'on' : ''}}" wx:for="{{progressSlots}}" wx:key="*this"></view>
    </view>
    <view class="manual-live">
      <view class="manual-left">
        <view class="manual-col-head">按实点选（字阳背阴）</view>
        <view class="manual-grid">
          <view class="manual-item" wx:for="{{manualOptions}}" wx:key="key" data-key="{{item.key}}" bindtap="pickManual">
            <view class="yao-bar {{item.score === 9 || item.score === 7 ? 'yang' : 'yin'}} {{item.score === 9 || item.score === 6 ? 'moving' : ''}}"></view>
            <view class="manual-lab">{{item.label}}</view>
          </view>
        </view>
      </view>
      <view class="manual-right">
        <view class="manual-col-head gua-col-head">成卦卦象</view>
        <view class="gua-side">
          <view class="gua-lines">
            <view class="gua-slot" wx:for="{{guaLines}}" wx:key="index">
              <view
                class="yao-bar xl {{item.filled ? (item.yinYang ? 'yang' : 'yin') : 'empty'}} {{item.changing ? 'moving' : ''}}"
              ></view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

</view>

<view class="footer-actions">
  <block wx:if="{{finished}}">
    <button class="btn-ghost half" bindtap="onBack">返回</button>
    <button class="btn-primary half" bindtap="submit">排卦</button>
  </block>
  <block wx:elif="{{mode === 'shake'}}">
    <button class="btn-ghost half" bindtap="onBack">返回</button>
    <button class="btn-primary half" bindtap="submit" disabled>排卦</button>
  </block>
  <block wx:else>
    <button class="btn-ghost half" bindtap="onBack">返回</button>
    <button class="btn-primary half" bindtap="undoLast" disabled="{{step === 0}}">
      {{step ? '撤回一爻' : '请选择爻象'}}
    </button>
  </block>
</view>
