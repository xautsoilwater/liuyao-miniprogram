.section-head {
  margin-bottom: 28rpx;
}

.cast-title {
  text-align: center;
  font-size: 64rpx;
  line-height: 1.25;
}

.cast-subtitle {
  margin-top: 10rpx;
  text-align: center;
  font-size: 30rpx;
  letter-spacing: 0.2em;
  text-indent: 0.2em;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  letter-spacing: 0.28em;
  font-size: 26rpx;
  color: var(--bronze);
  margin-bottom: 10rpx;
}

.q-input {
  padding: 18rpx 0;
  border: none;
  border-bottom: 1rpx solid var(--line-strong);
  background: transparent;
  font-size: 32rpx;
  letter-spacing: 0.08em;
}

.ask-summary {
  margin-bottom: 28rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid var(--line);
}

.ask-summary .row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.ask-summary .field-label {
  margin-bottom: 0;
}

.change-link {
  font-size: 24rpx;
  letter-spacing: 0.16em;
  color: var(--cinnabar);
}

.ask-q {
  margin-top: 12rpx;
  font-size: 32rpx;
  letter-spacing: 0.06em;
  line-height: 1.45;
  color: var(--ink);
}

.mode-row {
  display: flex;
  gap: 0;
  margin-bottom: 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.mode {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 30rpx;
  letter-spacing: 0.2em;
  color: var(--ink-soft);
  border-bottom: 4rpx solid transparent;
  margin-bottom: -1rpx;
}

.mode.on {
  color: var(--cinnabar);
  border-bottom-color: var(--cinnabar);
}

.stage {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  padding: 20rpx 24rpx 32rpx;
  border: 1rpx solid var(--line-strong);
  background: rgba(250, 246, 234, 0.72);
  box-shadow: inset 0 0 0 10rpx rgba(250, 246, 234, 0.28);
  overflow: visible;
}

.stage::before {
  content: "";
  position: absolute;
  inset: 10rpx;
  border: 1rpx solid rgba(28, 24, 20, 0.08);
  pointer-events: none;
}

.stage-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.progress-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  height: 28rpx;
  margin: 2rpx 0 0;
}

.progress-bead {
  width: 18rpx;
  height: 18rpx;
  border: 2rpx solid var(--bronze);
  transform: rotate(45deg);
  box-sizing: border-box;
}

.progress-bead.on {
  border-color: var(--cinnabar);
  background: var(--cinnabar);
}

.cast-shake-slot {
  position: relative;
  display: block;
  width: 300rpx;
  height: 112rpx;
  min-height: 0;
  margin: 2rpx auto 0;
  padding: 0;
  overflow: hidden;
  box-sizing: border-box;
  border-width: 4rpx;
  border-radius: 50% 50% 46% 46% / 58% 58% 42% 42%;
  color: #fff8e8;
  border-color: #56442f;
  background: linear-gradient(180deg, #8b7451, #655139);
  box-shadow:
    inset 0 0 0 8rpx rgba(255, 248, 225, 0.12),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.2),
    0 6rpx 16rpx rgba(73, 54, 34, 0.14);
}

.cast-shake-slot .shell-inset {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  top: 14rpx;
  bottom: 14rpx;
  border: 2rpx solid rgba(255, 244, 211, 0.45);
  border-radius: 50%;
  pointer-events: none;
}

.cast-shake-slot .shell-inset::before,
.cast-shake-slot .shell-inset::after {
  content: "";
  position: absolute;
  left: 50%;
  top: -5%;
  width: 2rpx;
  height: 110%;
  background: rgba(255, 244, 211, 0.24);
  transform-origin: 50% 50%;
}

.cast-shake-slot .shell-inset::before {
  transform: rotate(34deg);
}

.cast-shake-slot .shell-inset::after {
  transform: rotate(-34deg);
}

.cast-shake-slot .shell-label {
  position: relative;
  z-index: 2;
  letter-spacing: 0.22em;
}


/*
 * 左列：铜钱（仅硬币高度）→ 爻结果 → 摇铜钱按钮
 * 右列卦象：顶边 = 铜钱顶边，底边 = 按钮底边
 * 抛掷动画向上溢出，不占布局高度
 */
.stage-live {
  display: flex;
  gap: 16rpx;
  align-items: stretch;
  overflow: visible;
  padding-top: 200rpx; /* 略收紧留白，仍保留抛起空间 */
}

.stage-live .gua-side {
  transform: translateY(-20rpx);
}

.coin-stage {
  flex: 1.15;
  min-width: 0;
  display: flex;
  flex-direction: column;
  overflow: visible;
}

.coin-stage .btn-primary {
  margin: 0;
  width: 100%;
  box-sizing: border-box;
}

.gua-side {
  flex: 0.85;
  min-width: 120rpx;
  padding: 0 4rpx 0 12rpx;
  border-left: 1rpx dashed var(--line);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

/* 「卦象」标题放在铜钱上方空档，不占六爻对齐高度 */
.gua-side .gua-lab {
  position: absolute;
  left: 12rpx;
  right: 4rpx;
  top: -48rpx;
  margin: 0;
  letter-spacing: 0.36em;
  text-indent: 0.36em;
  color: var(--bronze);
  font-size: 28rpx;
}

.gua-side .gua-lines {
  flex: 1;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  gap: 0;
  margin: 0;
}

.gua-side .gua-slot {
  min-height: 0;
}

/* 方案二：玄木描金摇卦神筒 */
.shaker-stage {
  position: absolute;
  top: -24rpx;
  left: 50%;
  margin-left: -56rpx;
  width: 112rpx;
  height: 154rpx;
  z-index: 10;
  pointer-events: none;
  opacity: 0.88;
  transform: translate3d(0, 0, 0) rotate(-6deg);
  transform-origin: 50% 90%;
  transition: opacity 0.3s ease, transform 0.3s ease;
  filter: drop-shadow(0 12rpx 24rpx rgba(20, 15, 10, 0.28));
}

.shaker-svg {
  display: block;
  width: 100%;
  height: 100%;
  overflow: visible;
}

.cup-coin-glint {
  opacity: 0;
  transition: opacity 0.2s;
}

.is-shaking .cup-coin-glint {
  animation: coin-glint 0.28s ease-in-out infinite alternate;
}

@keyframes coin-glint {
  0% { opacity: 0.15; transform: scale(0.8); }
  100% { opacity: 0.95; transform: scale(1.25); }
}

.shaker-stage.is-shaking {
  opacity: 1;
  animation: vessel-cast 1.8s cubic-bezier(0.25, 0.1, 0.25, 1) both;
}

@keyframes vessel-cast {
  0% { transform: translate3d(0, 0, 0) rotate(-6deg); }
  10% { transform: translate3d(-24rpx, -32rpx, 0) rotate(-26deg); }
  22% { transform: translate3d(28rpx, -44rpx, 0) rotate(24deg); }
  34% { transform: translate3d(-28rpx, -48rpx, 0) rotate(-28deg); }
  46% { transform: translate3d(24rpx, -40rpx, 0) rotate(24deg); }
  58% { transform: translate3d(-16rpx, -28rpx, 0) rotate(-16deg); }
  66% { transform: translate3d(0, -20rpx, 0) rotate(0deg); }
  74% { transform: translate3d(36rpx, -4rpx, 0) rotate(58deg) scale(1.08); }
  84% { transform: translate3d(52rpx, 24rpx, 0) rotate(68deg) scale(1.02); opacity: 0.95; }
  92% { transform: translate3d(32rpx, -4rpx, 0) rotate(24deg) scale(0.88); opacity: 0.35; }
  100% { transform: translate3d(0, 0, 0) rotate(-6deg); opacity: 0.88; }
}

/* 铜钱区：高度=硬币本身；动画向上溢出 */
.coins {
  position: relative;
  display: flex;
  justify-content: center;
  gap: 18rpx;
  margin: 0 0 6rpx;
  height: 128rpx;
  min-height: 128rpx;
  align-items: flex-end;
  padding-bottom: 16rpx;
  box-sizing: border-box;
  overflow: visible;
  perspective: 1200rpx;
  transform-style: preserve-3d;
}

.coins::after {
  content: "";
  position: absolute;
  left: 10%;
  right: 10%;
  bottom: 10rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(90, 70, 40, 0.28), transparent);
  pointer-events: none;
}

/* 方案二：三钱从筒口倾出，空中翻腾下坠，触盘弹跳定格 */
.shake .coin-body {
  transform-style: preserve-3d;
  transform-origin: center center;
  animation: toss-drop 1.8s cubic-bezier(0.33, 0.02, 0.2, 1) both;
  will-change: transform, opacity;
}

.shake .coin:nth-child(1) .coin-body {
  animation-name: toss-drop-a;
  animation-duration: 1.8s;
  animation-delay: 0ms;
}
.shake .coin:nth-child(2) .coin-body {
  animation-name: toss-drop-b;
  animation-duration: 1.8s;
  animation-delay: 35ms;
}
.shake .coin:nth-child(3) .coin-body {
  animation-name: toss-drop-c;
  animation-duration: 1.8s;
  animation-delay: 70ms;
}

.shake .coin-shadow {
  animation: toss-shadow 1.8s cubic-bezier(0.33, 0.02, 0.2, 1) both;
  will-change: transform, opacity;
}
.shake .coin:nth-child(1) .coin-shadow {
  animation-name: toss-shadow-a;
  animation-duration: 1.8s;
  animation-delay: 0ms;
}
.shake .coin:nth-child(2) .coin-shadow {
  animation-name: toss-shadow-b;
  animation-duration: 1.8s;
  animation-delay: 35ms;
}
.shake .coin:nth-child(3) .coin-shadow {
  animation-name: toss-shadow-c;
  animation-duration: 1.8s;
  animation-delay: 70ms;
}

/* 左钱：从筒口倾出，偏左抛射，触桌反弹，斜倚打转定格 */
@keyframes toss-drop-a {
  0% { opacity: 0; transform: translate3d(-12rpx, -72rpx, 0) scale(0.25); }
  65% { opacity: 0; transform: translate3d(-12rpx, -72rpx, 0) scale(0.25); }
  68% { opacity: 1; transform: translate3d(-24rpx, -124rpx, 0) scale(0.8) rotateX(15deg) rotateY(60deg) rotateZ(-18deg); }
  75% { transform: translate3d(-48rpx, -236rpx, 0) scale(1.06) rotateX(25deg) rotateY(210deg) rotateZ(-36deg); }
  84% { transform: translate3d(-36rpx, 8rpx, 0) scale(1.04) rotateX(8deg) rotateY(430deg) rotateZ(18deg); }
  90% { transform: translate3d(-20rpx, -44rpx, 0) scale(0.98) rotateX(-5deg) rotateY(560deg) rotateZ(-12deg); }
  95% { transform: translate3d(-8rpx, 4rpx, 0) scale(1.02) rotateX(4deg) rotateY(660deg) rotateZ(8deg); }
  100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1) rotateX(0deg) rotateY(720deg) rotateZ(0deg); }
}

/* 中钱：从筒口飞跃，高抛直立自旋，触桌重弹，斜倚微旋 */
@keyframes toss-drop-b {
  0% { opacity: 0; transform: translate3d(0, -72rpx, 0) scale(0.25); }
  65% { opacity: 0; transform: translate3d(0, -72rpx, 0) scale(0.25); }
  68% { opacity: 1; transform: translate3d(0, -136rpx, 0) scale(0.85) rotateX(-10deg) rotateY(80deg) rotateZ(8deg); }
  76% { transform: translate3d(4rpx, -270rpx, 0) scale(1.1) rotateX(-20deg) rotateY(260deg) rotateZ(12deg); }
  85% { transform: translate3d(8rpx, 8rpx, 0) scale(1.05) rotateX(10deg) rotateY(480deg) rotateZ(-16deg); }
  91% { transform: translate3d(4rpx, -56rpx, 0) scale(0.97) rotateX(-6deg) rotateY(600deg) rotateZ(10deg); }
  96% { transform: translate3d(2rpx, 4rpx, 0) scale(1.02) rotateX(3deg) rotateY(690deg) rotateZ(-6deg); }
  100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1) rotateX(0deg) rotateY(720deg) rotateZ(0deg); }
}

/* 右钱：从筒口倾出，偏右滑行，触桌轻弹，旋动定格 */
@keyframes toss-drop-c {
  0% { opacity: 0; transform: translate3d(12rpx, -72rpx, 0) scale(0.25); }
  65% { opacity: 0; transform: translate3d(12rpx, -72rpx, 0) scale(0.25); }
  68% { opacity: 1; transform: translate3d(28rpx, -116rpx, 0) scale(0.8) rotateX(12deg) rotateY(-60deg) rotateZ(15deg); }
  75% { transform: translate3d(52rpx, -230rpx, 0) scale(1.05) rotateX(20deg) rotateY(-200deg) rotateZ(32deg); }
  84% { transform: translate3d(40rpx, 8rpx, 0) scale(1.04) rotateX(-6deg) rotateY(-420deg) rotateZ(-18deg); }
  90% { transform: translate3d(24rpx, -40rpx, 0) scale(0.98) rotateX(4deg) rotateY(-540deg) rotateZ(12deg); }
  95% { transform: translate3d(10rpx, 4rpx, 0) scale(1.02) rotateX(-3deg) rotateY(-650deg) rotateZ(-7deg); }
  100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1) rotateX(0deg) rotateY(720deg) rotateZ(0deg); }
}

@keyframes toss-shadow-a {
  0%, 65% { opacity: 0; transform: scaleX(0.1); }
  68% { opacity: 0.1; transform: translateX(-8rpx) scaleX(0.4); }
  75% { opacity: 0.05; transform: translateX(-16rpx) scaleX(0.22); }
  84% { opacity: 0.52; transform: translateX(-12rpx) scaleX(1.25); }
  90% { opacity: 0.14; transform: translateX(-8rpx) scaleX(0.5); }
  95% { opacity: 0.38; transform: translateX(-4rpx) scaleX(1.1); }
  100% { opacity: 0.28; transform: translateX(0) scaleX(1); }
}

@keyframes toss-shadow-b {
  0%, 65% { opacity: 0; transform: scaleX(0.1); }
  68% { opacity: 0.1; transform: scaleX(0.4); }
  76% { opacity: 0.04; transform: scaleX(0.2); }
  85% { opacity: 0.55; transform: scaleX(1.3); }
  91% { opacity: 0.15; transform: scaleX(0.48); }
  96% { opacity: 0.4; transform: scaleX(1.08); }
  100% { opacity: 0.28; transform: scaleX(1); }
}

@keyframes toss-shadow-c {
  0%, 65% { opacity: 0; transform: scaleX(0.1); }
  68% { opacity: 0.1; transform: translateX(8rpx) scaleX(0.4); }
  75% { opacity: 0.05; transform: translateX(16rpx) scaleX(0.22); }
  84% { opacity: 0.52; transform: translateX(12rpx) scaleX(1.25); }
  90% { opacity: 0.14; transform: translateX(8rpx) scaleX(0.5); }
  95% { opacity: 0.38; transform: translateX(4rpx) scaleX(1.1); }
  100% { opacity: 0.28; transform: translateX(0) scaleX(1); }
}

@keyframes toss-drop {
  0% { transform: translate3d(0, -40rpx, 0) scale(0.94); }
  100% { transform: translate3d(0, 0, 0) scale(1); }
}
@keyframes toss-shadow {
  0% { transform: scaleX(0.4); opacity: 0.1; }
  100% { transform: scaleX(1); opacity: 0.28; }
}

/* 结果区定高，避免有无爻象时框体跳动 */
.result-line {
  margin: 12rpx 0 24rpx;
  min-height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
}

.yao-label {
  font-size: 36rpx;
  letter-spacing: 0.28em;
  text-indent: 0.28em;
}

.mark {
  color: var(--cinnabar);
  margin-left: 8rpx;
}

.hint {
  margin: 0;
  letter-spacing: 0.12em;
}

.manual-live {
  display: flex;
  gap: 20rpx;
  align-items: stretch;
  margin-top: 16rpx;
  height: 550rpx;
  box-sizing: border-box;
}

.manual-left {
  flex: 1.25;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.manual-col-head {
  font-size: 25rpx;
  color: var(--bronze);
  letter-spacing: 0.12em;
  height: 44rpx;
  line-height: 44rpx;
  margin-bottom: 12rpx;
  text-align: center;
  white-space: nowrap;
}

.manual-col-head.gua-col-head {
  font-weight: 600;
  color: #6a4a22;
  letter-spacing: 0.28em;
  text-indent: 0.28em;
}

.manual-grid {
  flex: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 14rpx;
}

.manual-item {
  height: 100%;
  padding: 16rpx 10rpx;
  text-align: center;
  border: 1rpx solid var(--line-strong);
  letter-spacing: 0.12em;
  background: rgba(244, 234, 214, 0.65);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.manual-lab {
  font-size: 27rpx;
  font-weight: 500;
  white-space: nowrap;
}

.manual-right {
  flex: 0.95;
  min-width: 180rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.manual-live .gua-side {
  flex: 1;
  height: calc(100% - 56rpx);
  min-width: 140rpx;
  min-height: 0;
  padding: 24rpx 16rpx;
  background: linear-gradient(180deg, rgba(238, 227, 206, 0.92) 0%, rgba(226, 212, 185, 0.72) 100%);
  border: 1rpx dashed rgba(166, 124, 62, 0.55);
  border-radius: 12rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(20, 15, 12, 0.05);
  box-sizing: border-box;
}

.manual-live .gua-side .gua-lines {
  flex: 1;
  height: 100%;
  justify-content: space-between;
}

.gua-lab {
  letter-spacing: 0.36em;
  text-indent: 0.36em;
  color: var(--bronze);
  font-size: 28rpx;
  margin-bottom: 18rpx;
}

.gua-lines {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.gua-slot {
  min-height: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gua-panel .yao-bar.moving::after {
  right: -18rpx;
  width: 10rpx;
  height: 10rpx;
  margin-top: -5rpx;
}

.footer-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.half {
  flex: 1;
}

.cast-return {
  width: 100%;
  margin: 24rpx 0 20rpx;
  box-sizing: border-box;
}
