.section-head {
  margin-bottom: 28rpx;
}

.cast-title {
  text-align: center;
  font-size: 64rpx;
  line-height: 1.25;
}

.cast-subtitle {
  margin-top: 10rpx;
  text-align: center;
  font-size: 30rpx;
  letter-spacing: 0.2em;
  text-indent: 0.2em;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  letter-spacing: 0.28em;
  font-size: 26rpx;
  color: var(--bronze);
  margin-bottom: 10rpx;
}

.q-input {
  padding: 18rpx 0;
  border: none;
  border-bottom: 1rpx solid var(--line-strong);
  background: transparent;
  font-size: 32rpx;
  letter-spacing: 0.08em;
}

.ask-summary {
  margin-bottom: 28rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid var(--line);
}

.ask-summary .row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.ask-summary .field-label {
  margin-bottom: 0;
}

.change-link {
  font-size: 24rpx;
  letter-spacing: 0.16em;
  color: var(--cinnabar);
}

.ask-q {
  margin-top: 12rpx;
  font-size: 32rpx;
  letter-spacing: 0.06em;
  line-height: 1.45;
  color: var(--ink);
}

.mode-row {
  display: flex;
  gap: 0;
  margin-bottom: 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.mode {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 30rpx;
  letter-spacing: 0.2em;
  color: var(--ink-soft);
  border-bottom: 4rpx solid transparent;
  margin-bottom: -1rpx;
}

.mode.on {
  color: var(--cinnabar);
  border-bottom-color: var(--cinnabar);
}

.stage {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  padding: 20rpx 24rpx 32rpx;
  border: 1rpx solid var(--line-strong);
  background: rgba(250, 246, 234, 0.72);
  box-shadow: inset 0 0 0 10rpx rgba(250, 246, 234, 0.28);
  overflow: visible;
}

.stage::before {
  content: "";
  position: absolute;
  inset: 10rpx;
  border: 1rpx solid rgba(28, 24, 20, 0.08);
  pointer-events: none;
}

.stage-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.progress-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  height: 28rpx;
  margin: 2rpx 0 0;
}

.progress-bead {
  width: 18rpx;
  height: 18rpx;
  border: 2rpx solid var(--bronze);
  transform: rotate(45deg);
  box-sizing: border-box;
}

.progress-bead.on {
  border-color: var(--cinnabar);
  background: var(--cinnabar);
}

.cast-shake-slot {
  position: relative;
  display: block;
  width: 300rpx;
  height: 112rpx;
  min-height: 0;
  margin: 2rpx auto 0;
  padding: 0;
  overflow: hidden;
  box-sizing: border-box;
  border-width: 4rpx;
  border-radius: 50% 50% 46% 46% / 58% 58% 42% 42%;
  color: #fff8e8;
  border-color: #56442f;
  background: linear-gradient(180deg, #8b7451, #655139);
  box-shadow:
    inset 0 0 0 8rpx rgba(255, 248, 225, 0.12),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.2),
    0 6rpx 16rpx rgba(73, 54, 34, 0.14);
}

.cast-shake-slot .shell-inset {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  top: 14rpx;
  bottom: 14rpx;
  border: 2rpx solid rgba(255, 244, 211, 0.45);
  border-radius: 50%;
  pointer-events: none;
}

.cast-shake-slot .shell-inset::before,
.cast-shake-slot .shell-inset::after {
  content: "";
  position: absolute;
  left: 50%;
  top: -5%;
  width: 2rpx;
  height: 110%;
  background: rgba(255, 244, 211, 0.24);
  transform-origin: 50% 50%;
}

.cast-shake-slot .shell-inset::before {
  transform: rotate(34deg);
}

.cast-shake-slot .shell-inset::after {
  transform: rotate(-34deg);
}

.cast-shake-slot .shell-label {
  position: relative;
  z-index: 2;
  letter-spacing: 0.22em;
}


/*
 * 左列：铜钱（仅硬币高度）→ 爻结果 → 摇铜钱按钮
 * 右列卦象：顶边 = 铜钱顶边，底边 = 按钮底边
 * 抛掷动画向上溢出，不占布局高度
 */
.stage-live {
  display: flex;
  gap: 16rpx;
  align-items: stretch;
  overflow: visible;
  padding-top: 360rpx; /* 大幅增高卡片框，给大龟壳与抛跌动画舒展空间 */
}

.stage-live .gua-side {
  transform: translateY(-20rpx);
}

.coin-stage {
  flex: 1.15;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: visible;
  position: relative;
}

.coin-stage .btn-primary {
  margin: 24rpx 0 0;
  width: 100%;
  box-sizing: border-box;
}

.gua-side {
  flex: 0.85;
  min-width: 120rpx;
  padding: 0 4rpx 0 12rpx;
  border-left: 1rpx dashed var(--line);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

/* 「卦象」标题放在铜钱上方空档，不占六爻对齐高度 */
.gua-side .gua-lab {
  position: absolute;
  left: 12rpx;
  right: 4rpx;
  top: -48rpx;
  margin: 0;
  letter-spacing: 0.36em;
  text-indent: 0.36em;
  color: var(--bronze);
  font-size: 28rpx;
}

.gua-side .gua-lines {
  flex: 1;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  gap: 0;
  margin: 0;
}

.gua-side .gua-slot {
  min-height: 0;
}

/* 周易文王真身灵龟筮壳（真实器物 · 拟人双手捧执） */
.shaker-stage {
  position: absolute;
  top: -300rpx;
  left: 50%;
  margin-left: -156rpx;
  width: 312rpx;
  height: 208rpx;
  z-index: 10;
  pointer-events: none;
  opacity: 0.98;
  transform: translate3d(0, 0, 0) rotate(-2deg);
  transform-origin: 50% 65%;
  transition: opacity 0.3s ease, transform 0.3s ease;
  will-change: transform;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.shaker-vessel {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  will-change: transform;
  transform: translateZ(0);
}

.shaker-img {
  display: block;
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 14rpx 24rpx rgba(18, 12, 8, 0.38));
  will-change: transform;
  transform: translateZ(0);
}

.shell-coin-glint,
.cup-coin-glint {
  opacity: 0;
  transition: opacity 0.2s;
}

.is-shaking .shell-coin-glint,
.is-shaking .cup-coin-glint {
  animation: coin-glint 0.26s ease-in-out infinite alternate;
}

@keyframes coin-glint {
  0% { opacity: 0.1; transform: scale(0.8); }
  100% { opacity: 1; transform: scale(1.3); }
}

.shaker-stage.is-shaking {
  opacity: 1;
  animation: vessel-cast 2.2s cubic-bezier(0.25, 0.1, 0.25, 1) both;
  will-change: transform;
}

.shaker-stage.is-shaking .shaker-img {
  /* 摇动期间降低重度像素级高斯模糊负载，释放GPU算力确保满帧丝滑 */
  filter: drop-shadow(0 8rpx 14rpx rgba(18, 12, 8, 0.28));
}

/* 拟人化双手摇卦仪轨：双手捧执 -> 手腕3轮发力上下颠簸顿挫 -> 双手前推翻腕下倾倒出 -> 恭肃放平 */
@keyframes vessel-cast {
  0% { transform: translate3d(0, 0, 0) rotate(-2deg); }
  /* 0~16%：双手捧住接纳三钱飞入，双手顺势下沉蓄势端起 */
  10% { transform: translate3d(0, 8rpx, 0) rotate(0deg); }
  16% { transform: translate3d(0, -12rpx, 0) rotate(-2deg); }
  /* 18%~28%：第1次手腕发力向上用力颠起 ➡️ 沉顿挫震 */
  22% { transform: translate3d(-6rpx, -40rpx, 0) rotate(6deg); }
  28% { transform: translate3d(4rpx, 8rpx, 0) rotate(-4deg); }
  /* 30%~42%：第2次双手更大发力向上颠摇 ➡️ 失重沉落 */
  34% { transform: translate3d(-10rpx, -52rpx, 0) rotate(8deg); }
  42% { transform: translate3d(4rpx, 10rpx, 0) rotate(-5deg); }
  /* 44%~54%：第3次手腕快速颠颠碰撞 ➡️ 挫震收势 */
  48% { transform: translate3d(-4rpx, -36rpx, 0) rotate(5deg); }
  54% { transform: translate3d(0, 4rpx, 0) rotate(-2deg); }
  /* 56%~64%：双手在胸前平端微晃蓄势，准备前推翻腕 */
  60% { transform: translate3d(-2rpx, -12rpx, 0) rotate(1deg); }
  64% { transform: translate3d(0, -6rpx, 0) rotate(0deg); }
  /* 68%~78%：真实人手动作：双手向前推伸、手腕自然向前翻腕下压倾倒 */
  70% { transform: translate3d(24rpx, 24rpx, 0) rotate(48deg) scale(1.03); }
  76% { transform: translate3d(32rpx, 40rpx, 0) rotate(56deg) scale(1.02); }
  /* 78%~84%：铜钱滑落砸出，手腕一轻微滞顿挫 */
  82% { transform: translate3d(34rpx, 44rpx, 0) rotate(58deg); opacity: 0.98; }
  /* 86%~100%：双手平稳将龟壳收回胸前，缓缓放平端正，神态恭肃 */
  92% { transform: translate3d(14rpx, 16rpx, 0) rotate(16deg) scale(0.96); opacity: 0.75; }
  100% { transform: translate3d(0, 0, 0) rotate(-2deg); opacity: 0.95; }
}

/* 铜钱区：高度=硬币本身；动画向上溢出 */
.coins {
  position: relative;
  display: flex;
  justify-content: center;
  gap: 18rpx;
  margin: 0 0 6rpx;
  height: 128rpx;
  min-height: 128rpx;
  align-items: flex-end;
  padding-bottom: 16rpx;
  box-sizing: border-box;
  overflow: visible;
  perspective: 1200rpx;
  transform-style: preserve-3d;
}

.coins::after {
  content: "";
  position: absolute;
  left: 10%;
  right: 10%;
  bottom: 10rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(90, 70, 40, 0.28), transparent);
  pointer-events: none;
}

/* 方案二：金钱飞入龟壳 -> 摇动龟壳 -> 倾倒掉落 -> 击盘定格 */
.shake .coin-body {
  transform-style: preserve-3d;
  transform-origin: center center;
  animation: toss-drop 2.2s cubic-bezier(0.33, 0.02, 0.2, 1) both;
  will-change: transform, opacity;
}

.shake .coin:nth-child(1) .coin-body {
  animation-name: toss-drop-a;
  animation-duration: 2.2s;
  animation-delay: 0ms;
}
.shake .coin:nth-child(2) .coin-body {
  animation-name: toss-drop-b;
  animation-duration: 2.2s;
  animation-delay: 20ms;
}
.shake .coin:nth-child(3) .coin-body {
  animation-name: toss-drop-c;
  animation-duration: 2.2s;
  animation-delay: 40ms;
}

.shake .coin-shadow {
  animation: toss-shadow 2.2s cubic-bezier(0.33, 0.02, 0.2, 1) both;
  will-change: transform, opacity;
}
.shake .coin:nth-child(1) .coin-shadow {
  animation-name: toss-shadow-a;
  animation-duration: 2.2s;
  animation-delay: 0ms;
}
.shake .coin:nth-child(2) .coin-shadow {
  animation-name: toss-shadow-b;
  animation-duration: 2.2s;
  animation-delay: 20ms;
}
.shake .coin:nth-child(3) .coin-shadow {
  animation-name: toss-shadow-c;
  animation-duration: 2.2s;
  animation-delay: 40ms;
}

/* 左钱：飞入龟口 -> 龟内摇动隐匿 -> 自倾斜龟口滑出 -> 砸盘反弹定格 */
@keyframes toss-drop-a {
  0% { opacity: 1; transform: translate3d(0, 0, 0) scale(1) rotateX(0deg) rotateY(0deg) rotateZ(0deg); }
  9% { opacity: 1; transform: translate3d(120rpx, -200rpx, 0) scale(0.7) rotateX(25deg) rotateY(120deg) rotateZ(15deg); }
  17% { opacity: 0.9; transform: translate3d(222rpx, -300rpx, 0) scale(0.3) rotateX(45deg) rotateY(260deg) rotateZ(30deg); }
  20% { opacity: 0; transform: translate3d(222rpx, -300rpx, 0) scale(0.2) rotateX(45deg) rotateY(260deg) rotateZ(30deg); }
  66% { opacity: 0; transform: translate3d(242rpx, -156rpx, 0) scale(0.2) rotateX(30deg) rotateY(50deg) rotateZ(-15deg); }
  67% { opacity: 1; transform: translate3d(242rpx, -152rpx, 0) scale(0.36) rotateX(30deg) rotateY(50deg) rotateZ(-15deg); }
  72% { opacity: 1; transform: translate3d(190rpx, -100rpx, 0) scale(0.6) rotateX(45deg) rotateY(170deg) rotateZ(-24deg); }
  78% { opacity: 1; transform: translate3d(90rpx, -36rpx, 0) scale(0.88) rotateX(65deg) rotateY(310deg) rotateZ(-20deg); }
  84% { opacity: 1; transform: translate3d(-12rpx, 8rpx, 0) scale(1.05) rotateX(8deg) rotateY(450deg) rotateZ(16deg); }
  90% { opacity: 1; transform: translate3d(-8rpx, -28rpx, 0) scale(0.98) rotateX(-5deg) rotateY(580deg) rotateZ(-10deg); }
  96% { opacity: 1; transform: translate3d(-4rpx, 4rpx, 0) scale(1.02) rotateX(4deg) rotateY(680deg) rotateZ(6deg); }
  100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1) rotateX(0deg) rotateY(720deg) rotateZ(0deg); }
}

/* 中钱：飞入龟口 -> 龟内摇动隐匿 -> 最先自龟口倾泻 -> 砸盘反弹定格 */
@keyframes toss-drop-b {
  0% { opacity: 1; transform: translate3d(0, 0, 0) scale(1) rotateX(0deg) rotateY(0deg) rotateZ(0deg); }
  9% { opacity: 1; transform: translate3d(50rpx, -200rpx, 0) scale(0.7) rotateX(-20deg) rotateY(140deg) rotateZ(0deg); }
  17% { opacity: 0.9; transform: translate3d(90rpx, -300rpx, 0) scale(0.3) rotateX(-40deg) rotateY(300deg) rotateZ(0deg); }
  20% { opacity: 0; transform: translate3d(90rpx, -300rpx, 0) scale(0.2) rotateX(-40deg) rotateY(300deg) rotateZ(0deg); }
  64% { opacity: 0; transform: translate3d(110rpx, -156rpx, 0) scale(0.2) rotateX(25deg) rotateY(60deg) rotateZ(10deg); }
  65% { opacity: 1; transform: translate3d(110rpx, -152rpx, 0) scale(0.36) rotateX(25deg) rotateY(60deg) rotateZ(10deg); }
  70% { opacity: 1; transform: translate3d(80rpx, -100rpx, 0) scale(0.6) rotateX(40deg) rotateY(160deg) rotateZ(15deg); }
  76% { opacity: 1; transform: translate3d(36rpx, -36rpx, 0) scale(0.88) rotateX(60deg) rotateY(280deg) rotateZ(12deg); }
  82% { opacity: 1; transform: translate3d(0, 8rpx, 0) scale(1.06) rotateX(10deg) rotateY(460deg) rotateZ(-14deg); }
  88% { opacity: 1; transform: translate3d(0, -32rpx, 0) scale(0.97) rotateX(-6deg) rotateY(580deg) rotateZ(8deg); }
  95% { opacity: 1; transform: translate3d(0, 4rpx, 0) scale(1.02) rotateX(3deg) rotateY(680deg) rotateZ(-4deg); }
  100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1) rotateX(0deg) rotateY(720deg) rotateZ(0deg); }
}

/* 右钱：飞入龟口 -> 龟内摇动隐匿 -> 自倾斜龟口滑出 -> 砸盘反弹定格 */
@keyframes toss-drop-c {
  0% { opacity: 1; transform: translate3d(0, 0, 0) scale(1) rotateX(0deg) rotateY(0deg) rotateZ(0deg); }
  9% { opacity: 1; transform: translate3d(-20rpx, -200rpx, 0) scale(0.7) rotateX(20deg) rotateY(-120deg) rotateZ(-15deg); }
  17% { opacity: 0.9; transform: translate3d(-42rpx, -300rpx, 0) scale(0.3) rotateX(40deg) rotateY(-260deg) rotateZ(-30deg); }
  20% { opacity: 0; transform: translate3d(-42rpx, -300rpx, 0) scale(0.2) rotateX(40deg) rotateY(-260deg) rotateZ(-30deg); }
  68% { opacity: 0; transform: translate3d(-22rpx, -160rpx, 0) scale(0.2) rotateX(20deg) rotateY(-50deg) rotateZ(18deg); }
  69% { opacity: 1; transform: translate3d(-22rpx, -156rpx, 0) scale(0.36) rotateX(20deg) rotateY(-50deg) rotateZ(18deg); }
  74% { opacity: 1; transform: translate3d(-16rpx, -96rpx, 0) scale(0.66) rotateX(35deg) rotateY(-160deg) rotateZ(25deg); }
  80% { opacity: 1; transform: translate3d(-8rpx, -32rpx, 0) scale(0.92) rotateX(55deg) rotateY(-300deg) rotateZ(22deg); }
  85% { opacity: 1; transform: translate3d(0, 8rpx, 0) scale(1.05) rotateX(-6deg) rotateY(-440deg) rotateZ(-16deg); }
  91% { opacity: 1; transform: translate3d(0, -24rpx, 0) scale(0.98) rotateX(4deg) rotateY(-560deg) rotateZ(10deg); }
  96% { opacity: 1; transform: translate3d(0, 4rpx, 0) scale(1.02) rotateX(-3deg) rotateY(-660deg) rotateZ(-5deg); }
  100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1) rotateX(0deg) rotateY(720deg) rotateZ(0deg); }
}

@keyframes toss-shadow-a {
  0% { opacity: 0.28; transform: scaleX(1); }
  8% { opacity: 0.08; transform: translateX(8rpx) scaleX(0.4); }
  16% { opacity: 0; transform: scaleX(0.1); }
  66% { opacity: 0; transform: scaleX(0.1); }
  67% { opacity: 0.12; transform: translateX(12rpx) scaleX(0.35); }
  74% { opacity: 0.22; transform: translateX(-8rpx) scaleX(0.65); }
  80% { opacity: 0.38; transform: translateX(-24rpx) scaleX(0.95); }
  85% { opacity: 0.58; transform: translateX(-32rpx) scaleX(1.3); }
  90% { opacity: 0.16; transform: translateX(-20rpx) scaleX(0.5); }
  96% { opacity: 0.38; transform: translateX(-8rpx) scaleX(1.1); }
  100% { opacity: 0.28; transform: translateX(0) scaleX(1); }
}

@keyframes toss-shadow-b {
  0% { opacity: 0.28; transform: scaleX(1); }
  8% { opacity: 0.08; transform: scaleX(0.4); }
  16% { opacity: 0; transform: scaleX(0.1); }
  64% { opacity: 0; transform: scaleX(0.1); }
  65% { opacity: 0.12; transform: translateX(16rpx) scaleX(0.35); }
  72% { opacity: 0.25; transform: translateX(8rpx) scaleX(0.65); }
  78% { opacity: 0.42; transform: translateX(2rpx) scaleX(0.95); }
  83% { opacity: 0.6; transform: translateX(0) scaleX(1.35); }
  89% { opacity: 0.18; transform: scaleX(0.5); }
  95% { opacity: 0.4; transform: scaleX(1.1); }
  100% { opacity: 0.28; transform: scaleX(1); }
}

@keyframes toss-shadow-c {
  0% { opacity: 0.28; transform: scaleX(1); }
  8% { opacity: 0.08; transform: translateX(-8rpx) scaleX(0.4); }
  16% { opacity: 0; transform: scaleX(0.1); }
  68% { opacity: 0; transform: scaleX(0.1); }
  69% { opacity: 0.12; transform: translateX(20rpx) scaleX(0.35); }
  76% { opacity: 0.22; transform: translateX(28rpx) scaleX(0.65); }
  82% { opacity: 0.38; transform: translateX(30rpx) scaleX(0.95); }
  86% { opacity: 0.58; transform: translateX(28rpx) scaleX(1.3); }
  91% { opacity: 0.16; transform: translateX(16rpx) scaleX(0.5); }
  96% { opacity: 0.38; transform: translateX(6rpx) scaleX(1.1); }
  100% { opacity: 0.28; transform: translateX(0) scaleX(1); }
}


@keyframes toss-drop {
  0% { transform: translate3d(0, -40rpx, 0) scale(0.94); }
  100% { transform: translate3d(0, 0, 0) scale(1); }
}
@keyframes toss-shadow {
  0% { transform: scaleX(0.4); opacity: 0.1; }
  100% { transform: scaleX(1); opacity: 0.28; }
}

/* 结果区定高，避免有无爻象时框体跳动 */
.result-line {
  margin: 8rpx 0 20rpx;
  min-height: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
}

.yao-label {
  font-size: 36rpx;
  letter-spacing: 0.28em;
  text-indent: 0.28em;
}

.mark {
  color: var(--cinnabar);
  margin-left: 8rpx;
}

.hint {
  margin: 0;
  letter-spacing: 0.12em;
}

.manual-live {
  display: flex;
  gap: 20rpx;
  align-items: stretch;
  margin-top: 16rpx;
  height: 550rpx;
  box-sizing: border-box;
}

.manual-left {
  flex: 1.25;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.manual-col-head {
  font-size: 25rpx;
  color: var(--bronze);
  letter-spacing: 0.12em;
  height: 44rpx;
  line-height: 44rpx;
  margin-bottom: 12rpx;
  text-align: center;
  white-space: nowrap;
}

.manual-col-head.gua-col-head {
  font-weight: 600;
  color: #6a4a22;
  letter-spacing: 0.28em;
  text-indent: 0.28em;
}

.manual-grid {
  flex: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 14rpx;
}

.manual-item {
  height: 100%;
  padding: 16rpx 10rpx;
  text-align: center;
  border: 1rpx solid var(--line-strong);
  letter-spacing: 0.12em;
  background: rgba(244, 234, 214, 0.65);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.manual-lab {
  font-size: 27rpx;
  font-weight: 500;
  white-space: nowrap;
}

.manual-right {
  flex: 0.95;
  min-width: 180rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.manual-live .gua-side {
  flex: 1;
  height: calc(100% - 56rpx);
  min-width: 140rpx;
  min-height: 0;
  padding: 24rpx 16rpx;
  background: linear-gradient(180deg, rgba(238, 227, 206, 0.92) 0%, rgba(226, 212, 185, 0.72) 100%);
  border: 1rpx dashed rgba(166, 124, 62, 0.55);
  border-radius: 12rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(20, 15, 12, 0.05);
  box-sizing: border-box;
}

.manual-live .gua-side .gua-lines {
  flex: 1;
  height: 100%;
  justify-content: space-between;
}

.gua-lab {
  letter-spacing: 0.36em;
  text-indent: 0.36em;
  color: var(--bronze);
  font-size: 28rpx;
  margin-bottom: 18rpx;
}

.gua-lines {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.gua-slot {
  min-height: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gua-panel .yao-bar.moving::after {
  right: -18rpx;
  width: 10rpx;
  height: 10rpx;
  margin-top: -5rpx;
}

.footer-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.half {
  flex: 1;
}

.cast-return {
  width: 100%;
  margin: 24rpx 0 20rpx;
  box-sizing: border-box;
}
