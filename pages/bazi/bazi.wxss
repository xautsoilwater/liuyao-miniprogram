.bazi-page {
  padding: 24rpx 32rpx 80rpx;
  box-sizing: border-box;
}

.bazi-hero {
  text-align: center;
  margin-bottom: 24rpx;
}

.bazi-intro-card {
  margin: 20rpx 0 32rpx;
  padding: 24rpx 20rpx;
  border: 1rpx solid rgba(154, 54, 42, .32);
  background: linear-gradient(180deg, rgba(168,52,38,.07), rgba(246,237,216,.34));
  text-align: center;
  font-size: 26rpx;
  line-height: 1.75;
  color: var(--ink-soft);
}

.bazi-form-row {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 26rpx;
  letter-spacing: 0.2em;
  color: var(--bronze);
  margin-bottom: 12rpx;
}

.gender-grid {
  display: flex;
  gap: 20rpx;
  margin: 16rpx 0 28rpx;
}

.gender-btn {
  flex: 1;
  padding: 22rpx 0;
  text-align: center;
  border: 2rpx solid var(--line-strong);
  background: rgba(250, 246, 234, 0.7);
  font-size: 30rpx;
  letter-spacing: 0.16em;
  color: var(--ink-soft);
  transition: all 0.2s ease;
}

.gender-btn.on {
  border-color: var(--cinnabar);
  color: var(--cinnabar);
  background: var(--cinnabar-soft);
  font-weight: 600;
  box-shadow: inset 0 0 0 1rpx rgba(155, 45, 36, 0.2);
}

.calendar-grid {
  margin-bottom: 0;
}

.picker-box {
  width: 100%;
  padding: 20rpx 16rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--line-strong);
  background: rgba(250, 246, 234, 0.8);
  color: var(--ink);
  font-size: 29rpx;
  letter-spacing: 0.05em;
}

.date-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--ink-soft);
  letter-spacing: 0.06em;
}

.bazi-birth-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--bronze);
  line-height: 1.6;
}

.bazi-board {
  border: 2rpx solid var(--line-strong);
  background: linear-gradient(180deg, rgba(246,237,216,.96), rgba(231,217,191,.84));
  padding: 24rpx 10rpx 16rpx;
  margin: 20rpx 0 28rpx;
}

.bazi-pillars-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 6rpx;
  text-align: center;
  margin: 16rpx 0;
}

.bazi-col {
  padding: 10rpx 4rpx;
  border-left: 1rpx dashed var(--line);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  align-items: center;
}

.bazi-col:first-child {
  border-left: none;
}

.bazi-col-title {
  font-size: 24rpx;
  color: var(--bronze);
  letter-spacing: 0.15em;
}

.bazi-shishen {
  font-size: 23rpx;
  color: var(--ink-soft);
}

.bazi-shishen.day {
  color: var(--cinnabar);
  font-weight: 600;
}

.bazi-char {
  font-size: 52rpx;
  line-height: 1.15;
  font-weight: 700;
  font-family: var(--serif);
  margin: 4rpx 0;
}

.wx-木 { color: #2e663a; }
.wx-火 { color: #a12c25; }
.wx-土 { color: #7a5833; }
.wx-金 { color: #9c7b23; }
.wx-水 { color: #285473; }

.bazi-cang-box {
  margin: 6rpx 0;
}

.bazi-cang-item {
  font-size: 21rpx;
  line-height: 1.35;
  color: var(--ink-soft);
}

.bazi-changsheng {
  font-size: 22rpx;
  color: var(--ink-2);
}

.bazi-nayin {
  font-size: 20rpx;
  color: var(--bronze);
  margin-top: 6rpx;
}

.bazi-shensha-box {
  margin-top: 8rpx;
  min-height: 36rpx;
}

.bazi-shensha-tag {
  font-size: 19rpx;
  padding: 2rpx 6rpx;
  margin: 2rpx 0;
  background: rgba(155,45,36,.06);
  border: 1rpx solid rgba(155,45,36,.2);
  color: var(--cinnabar);
  border-radius: 4rpx;
  display: block;
}

.bazi-pattern-summary {
  text-align: center;
  font-size: 22rpx;
  color: var(--bronze);
  border-top: 1rpx dashed var(--line);
  padding-top: 12rpx;
  margin-top: 14rpx;
  line-height: 1.5;
}

.energy-card {
  margin: 24rpx 0;
  padding: 24rpx 20rpx;
  border: 1rpx solid var(--line-strong);
  background: rgba(246,237,216,.58);
}

.card-sec-title {
  font-size: 26rpx;
  letter-spacing: 0.2em;
  color: var(--bronze);
  font-weight: 600;
}

.energy-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 12rpx 0;
  font-size: 25rpx;
}

.energy-label {
  width: 52rpx;
  font-weight: 600;
}

.energy-bar-wrap {
  flex: 1;
  height: 16rpx;
  background: rgba(20,15,12,.08);
  border-radius: 8rpx;
  overflow: hidden;
  position: relative;
}

.energy-bar {
  height: 100%;
  border-radius: 8rpx;
}

.energy-val {
  width: 68rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--ink-soft);
}

.dayun-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.dayun-sub {
  font-size: 22rpx;
  color: var(--ink-soft);
}

.dayun-scroll {
  display: flex;
  flex-direction: row;
  width: 100%;
  padding: 12rpx 0;
  box-sizing: border-box;
}

.dayun-card {
  flex: 0 0 120rpx;
  padding: 14rpx 6rpx;
  margin-right: 14rpx;
  text-align: center;
  border: 1rpx solid var(--line-strong);
  background: rgba(250,246,234,.7);
  box-sizing: border-box;
}

.dayun-card.active {
  border-color: var(--cinnabar);
  background: var(--cinnabar-soft);
}

.dayun-age {
  font-size: 20rpx;
  color: var(--bronze);
}

.dayun-gz {
  font-size: 32rpx;
  font-weight: 600;
  margin: 6rpx 0;
  color: var(--ink);
}

.dayun-ss {
  font-size: 21rpx;
  color: var(--ink-soft);
}

.dayun-ny {
  font-size: 18rpx;
  color: var(--bronze);
  margin-top: 4rpx;
}

.interpret-section {
  margin: 28rpx 0 12rpx;
}

.dimen-card {
  margin: 18rpx 0;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--line-strong);
  background: rgba(250,246,234,.65);
  border-left: 5rpx solid var(--bronze);
}

.dimen-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.dimen-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.12em;
}

.dimen-summary {
  font-size: 22rpx;
  color: var(--cinnabar);
  letter-spacing: 0.08em;
}

.dimen-body {
  font-size: 25rpx;
  line-height: 1.8;
  color: var(--ink-soft);
  text-align: justify;
}
