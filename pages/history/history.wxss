.item {
  padding: 22rpx 0;
  border-top: 1rpx solid var(--line);
}

.item .row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.name {
  font-size: 34rpx;
  letter-spacing: 0.18em;
  flex: 1;
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Source Han Serif SC", "SimSun", serif;
}

.time {
  margin-top: 8rpx;
  font-size: 26rpx;
}
