<view class="page index">
  <view class="hero" style="padding-top: {{homeHeaderTop}}px">
    <view class="brand" aria-label="周易">
      <image class="brand-img" src="/assets/images/brand-zhouyi.png" mode="widthFix" />
    </view>
    <view class="brand-sub">
      <text>敬卜以问道</text><text class="brand-dot">·</text>
      <text>观变以知几</text><text class="brand-dot">·</text>
      <text>明理而不惑</text>
    </view>
  </view>

  <view class="luopan-stage">
    <luopan />
  </view>

  <view class="pillar-portal">
    <view class="pillar-card main" bindtap="goCast" hover-class="pillar-hover" role="button" aria-label="神机断卦">
      <view class="pillar-corner tl"></view><view class="pillar-corner tr"></view>
      <view class="pillar-corner bl"></view><view class="pillar-corner br"></view>
      <view class="pillar-glow"></view>
      <view class="pillar-seal">太史令</view>
      <view class="pillar-body">
        <view class="pillar-title">神 机 断 卦</view>
        <view class="pillar-desc">六爻精微 · 澄心问卜 · 义理时空推演</view>
      </view>
      <view class="pillar-arrow">✦</view>
    </view>
    <view class="pillar-sub-row">
      <view class="pillar-card sub" bindtap="goLearn" hover-class="pillar-hover" role="button" aria-label="研习典要">
        <view class="sub-seal">典</view>
        <view class="sub-text">
          <text class="sub-title">研习典要</text>
          <text class="sub-sub">经传义理 · 卦典渊薮</text>
        </view>
      </view>
      <view class="pillar-card sub" bindtap="goBazi" hover-class="pillar-hover" role="button" aria-label="命理分析">
        <view class="sub-seal">命</view>
        <view class="sub-text">
          <text class="sub-title">命理分析</text>
          <text class="sub-sub">四柱干支 · 八字气运</text>
        </view>
      </view>
    </view>
  </view>

  <view class="foot-links">
    <view class="text-link" bindtap="goAccount">{{accountLabel}}</view>
    <view class="dot">·</view>
    <view class="text-link" bindtap="goHistory">历史卦例</view>
    <view class="dot">·</view>
    <view class="text-link feedback-cell">
      <text>问题留言</text>
      <button class="feedback-link" open-type="feedback" aria-label="问题留言"></button>
    </view>
  </view>

  <view class="taishi-seal-foot">
    <text>✦ 太史令 · 神机断卦新制 ✦</text>
  </view>
</view>
