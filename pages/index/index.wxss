.index {
  padding-top: 0;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  /* 整页内容尽量落在首屏，登录不被顶出 */
  justify-content: flex-start;
}

.hero {
  text-align: center;
  animation: rise 0.55s ease both;
  box-sizing: border-box;
  margin-bottom: 0;
  flex-shrink: 0;
}

.brand {
  display: flex;
  justify-content: center;
  align-items: center;
  line-height: 1;
}
.brand-img {
  width: 280rpx;
  height: auto;
  display: block;
}

.brand-sub {
  margin: 8rpx auto 4rpx;
  padding: 10rpx 8rpx;
  width: 96%;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
  font-size: 25rpx;
  font-weight: 600;
  letter-spacing: 0.1em;
  color: var(--ink-soft);
}

.brand-dot {
  padding: 0 12rpx;
  color: var(--cinnabar);
}

.luopan-stage {
  margin: 0 auto;
  flex: 0 0 auto;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  transform: translateY(-16rpx);
  animation: rise 0.65s ease 0.05s both;
}

.actions {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 22rpx;
  margin-top: 20rpx;
  padding: 20rpx 4rpx;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
  flex-shrink: 0;
  animation: rise 0.7s ease 0.1s both;
}

.act {
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 34rpx;
  letter-spacing: 0.16em;
  text-indent: 0;
  color: var(--ink-2);
  padding: 12rpx 4rpx;
  font-weight: 600;
}

.act.primary {
  color: var(--cinnabar);
  font-weight: 400;
}

.act-hover {
  opacity: 0.55;
}

.foot-links {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 22rpx minmax(0, 1fr) 22rpx minmax(0, 1fr);
  align-items: center;
  gap: 0;
  width: 100%;
  box-sizing: border-box;
  margin-top: 22rpx;
  padding: 0 4rpx 12rpx;
  flex-shrink: 0;
  opacity: 0.85;
}

.text-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  white-space: nowrap;
  text-align: center;
  letter-spacing: 0.2em;
  text-indent: 0.1em;
  font-size: 27rpx;
  font-family: var(--serif);
  font-weight: 400;
  line-height: 1.8;
  color: var(--ink-soft);
  padding: 10rpx 0;
}

.dot {
  width: 22rpx;
  text-align: center;
  color: var(--bronze);
  font-size: 28rpx;
}

.feedback-cell {
  position: relative;
}

.feedback-link {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  min-height: 0;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  opacity: 0;
}

.feedback-link::after {
  border: 0;
}

@keyframes rise {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}
