.index {
  padding-top: 0;
  padding-left: 28rpx;
  padding-right: 28rpx;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  justify-content: flex-start;
}

.hero {
  text-align: center;
  animation: rise 0.55s ease both;
  box-sizing: border-box;
  margin-bottom: 0;
  flex-shrink: 0;
}

.brand {
  display: flex;
  justify-content: center;
  align-items: center;
  line-height: 1;
}
.brand-img {
  width: 266rpx;
  height: auto;
  display: block;
}

.brand-sub {
  margin: 6rpx auto 4rpx;
  padding: 6rpx 6rpx;
  width: 96%;
  border-top: 1rpx solid rgba(197, 160, 89, 0.35);
  border-bottom: 1rpx solid rgba(197, 160, 89, 0.35);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
  color: var(--ink-soft);
}

.brand-dot {
  padding: 0 12rpx;
  color: var(--cinnabar);
}

.luopan-stage {
  margin: 0 auto;
  flex: 0 0 auto;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  transform: translateY(-12rpx);
  animation: rise 0.65s ease 0.05s both;
}

/* 首页殿堂级三大核心门户卡片 */
.pillar-portal {
  margin: 12rpx 0 10rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  animation: rise 0.7s ease 0.1s both;
}

.pillar-card.main {
  position: relative;
  padding: 22rpx 20rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #a32c25 0%, #7d1c19 100%);
  border: 1rpx solid rgba(230, 211, 163, 0.48);
  box-shadow: 0 14rpx 36rpx rgba(158, 42, 43, 0.32), 0 2rpx 8rpx rgba(158, 42, 43, 0.2), inset 0 1rpx 0 rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  gap: 16rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.pillar-hover {
  transform: scale(0.985);
  opacity: 0.9;
}

.pillar-corner {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-color: rgba(240, 225, 185, 0.7);
  border-style: solid;
}
.pillar-corner.tl { top: 6rpx; left: 6rpx; border-width: 2rpx 0 0 2rpx; }
.pillar-corner.tr { top: 6rpx; right: 6rpx; border-width: 2rpx 2rpx 0 0; }
.pillar-corner.bl { bottom: 6rpx; left: 6rpx; border-width: 0 0 2rpx 2rpx; }
.pillar-corner.br { bottom: 6rpx; right: 6rpx; border-width: 0 2rpx 2rpx 0; }

.pillar-glow {
  position: absolute;
  right: -30rpx;
  top: -30rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(235, 215, 170, 0.25) 0%, transparent 70%);
}

.pillar-seal {
  flex-shrink: 0;
  padding: 6rpx 8rpx;
  border: 1rpx solid rgba(240, 225, 185, 0.6);
  background: rgba(120, 24, 20, 0.6);
  color: #f7e8c3;
  font-size: 20rpx;
  letter-spacing: 0.16em;
  line-height: 1.25;
  writing-mode: vertical-rl;
  border-radius: 4rpx;
  box-shadow: inset 0 0 6rpx rgba(0, 0, 0, 0.25);
}

.pillar-body {
  flex: 1;
  min-width: 0;
}

.pillar-title {
  font-size: 32rpx;
  letter-spacing: 0.26em;
  color: #fff9ed;
  font-weight: 700;
  text-shadow: 0 2rpx 4rpx rgba(40, 10, 8, 0.4);
  line-height: 1.3;
}

.pillar-desc {
  margin-top: 5rpx;
  font-size: 21rpx;
  letter-spacing: 0.06em;
  color: rgba(250, 242, 226, 0.85);
  line-height: 1.4;
}

.pillar-arrow {
  flex-shrink: 0;
  color: rgba(240, 225, 185, 0.75);
  font-size: 24rpx;
}

.pillar-sub-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.pillar-card.sub {
  padding: 16rpx 14rpx;
  border-radius: 10rpx;
  background: rgba(255, 252, 246, 0.88);
  border: 1rpx solid rgba(197, 160, 89, 0.38);
  box-shadow: 0 6rpx 20rpx rgba(45, 32, 20, 0.04), inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-sizing: border-box;
}

.sub-seal {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(158, 42, 43, 0.35);
  background: rgba(158, 42, 43, 0.06);
  color: var(--cinnabar);
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 4rpx;
}

.sub-text {
  flex: 1;
  min-width: 0;
}

.sub-title {
  display: block;
  font-size: 28rpx;
  letter-spacing: 0.1em;
  color: var(--ink);
  font-weight: 600;
  line-height: 1.3;
}

.sub-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  letter-spacing: 0.02em;
  color: var(--ink-soft);
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.foot-links {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 22rpx minmax(0, 1fr) 22rpx minmax(0, 1fr);
  align-items: center;
  gap: 0;
  width: 100%;
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 0 4rpx 8rpx;
  flex-shrink: 0;
  opacity: 0.85;
}

.text-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  white-space: nowrap;
  text-align: center;
  letter-spacing: 0.2em;
  text-indent: 0.1em;
  font-size: 27rpx;
  font-family: var(--serif);
  font-weight: 400;
  line-height: 1.8;
  color: var(--ink-soft);
  padding: 10rpx 0;
}

.dot {
  width: 22rpx;
  text-align: center;
  color: var(--bronze);
  font-size: 28rpx;
}

.feedback-cell {
  position: relative;
}

.feedback-link {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  min-height: 0;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  opacity: 0;
}

.feedback-link::after {
  border: 0;
}

.taishi-seal-foot {
  text-align: center;
  font-size: 22rpx;
  color: var(--bronze);
  margin-top: 18rpx;
  letter-spacing: 2rpx;
  opacity: 0.8;
}

@keyframes rise {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}
