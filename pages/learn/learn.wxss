.learn-hero {
  text-align: center;
  margin-bottom: 12rpx;
  padding-bottom: 8rpx;
}

.learn-hero .title-zh {
  margin-top: 12rpx;
  font-size: 50rpx;
  letter-spacing: 0.36em;
  text-indent: 0.36em;
}

.lede {
  margin-top: 14rpx;
  font-size: 28rpx;
  letter-spacing: 0.16em;
  color: var(--ink-soft);
  line-height: 1.7;
}

.learn-catalog {
  position: relative;
}

.vol-nav {
  position: sticky;
  top: 0;
  z-index: 16;
  margin: 8rpx -8rpx 12rpx;
  padding: 16rpx 14rpx 18rpx;
  background:
    linear-gradient(180deg, rgba(245, 237, 217, 0.98) 0%, rgba(235, 224, 200, 0.96) 100%);
  border-top: 1rpx solid var(--line-strong);
  border-bottom: 1rpx solid var(--line-strong);
  box-shadow: 0 10rpx 22rpx rgba(28, 24, 20, 0.05);
}

.vol-nav-label {
  text-align: center;
  font-size: 22rpx;
  letter-spacing: 0.42em;
  text-indent: 0.42em;
  color: var(--cinnabar);
  margin-bottom: 12rpx;
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Source Han Serif SC", "SimSun", serif;
}

.vol-nav-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}

.vol-chip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 8rpx 4rpx 10rpx;
  border: 1rpx solid rgba(110, 90, 62, 0.22);
  background: rgba(250, 246, 234, 0.58);
}

.vol-chip-hover {
  opacity: 0.72;
}

.vol-chip.on {
  border-color: rgba(155, 45, 36, 0.72);
  background: rgba(155, 45, 36, 0.09);
  box-shadow: inset 0 0 0 1rpx rgba(155, 45, 36, 0.12);
}

.vol-chip-vol {
  font-size: 20rpx;
  letter-spacing: 0.14em;
  color: var(--bronze);
  line-height: 1.3;
}

.vol-chip.on .vol-chip-vol {
  color: var(--cinnabar);
}

.vol-chip-name {
  font-size: 26rpx;
  letter-spacing: 0.18em;
  text-indent: 0.08em;
  color: var(--ink);
  line-height: 1.4;
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Source Han Serif SC", "SimSun", serif;
}

.vol-chip.on .vol-chip-name {
  color: var(--cinnabar);
}

.group {
  margin-bottom: 8rpx;
  scroll-margin-top: 200rpx;
}

.cat-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 40rpx 0 8rpx;
}

.cat-block {
  flex-shrink: 0;
}

.cat {
  font-size: 32rpx;
  letter-spacing: 0.28em;
  text-indent: 0.08em;
  color: var(--cinnabar);
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Source Han Serif SC", "SimSun", serif;
}

.cat-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  letter-spacing: 0.12em;
}

.cat-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(155, 45, 36, 0.35), transparent);
}

.cat-count {
  flex-shrink: 0;
  font-size: 24rpx;
  letter-spacing: 0.1em;
  color: var(--bronze);
}

.article {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 26rpx 8rpx;
  border-top: 1rpx solid var(--line);
  background: linear-gradient(90deg, rgba(250, 246, 234, 0.25), transparent 60%);
}

.a-idx {
  width: 40rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  letter-spacing: 0.06em;
  color: var(--bronze-light);
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.article-hover {
  opacity: 0.72;
}

.a-main {
  flex: 1;
  min-width: 0;
}

.a-title {
  font-size: 32rpx;
  letter-spacing: 0.16em;
  margin-bottom: 8rpx;
  color: var(--ink);
  font-weight: 600;
}

.a-side {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding-left: 8rpx;
}

.a-cover {
  font-size: 32rpx;
  color: var(--bronze);
  opacity: 0.85;
}

.a-go {
  font-size: 32rpx;
  color: var(--cinnabar);
  opacity: 0.55;
  padding: 0 8rpx;
}

.learn-foot {
  margin-top: 48rpx;
  text-align: center;
  letter-spacing: 0.2em;
  font-size: 26rpx;
  color: var(--bronze);
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Source Han Serif SC", "SimSun", serif;
}

.guadian-banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 8rpx 0 20rpx;
  padding: 22rpx 20rpx;
  border: 1rpx solid rgba(155, 45, 36, 0.35);
  background: linear-gradient(135deg, rgba(155, 45, 36, 0.08), rgba(250, 246, 234, 0.7));
}
.gb-seal {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  font-size: 22rpx;
  letter-spacing: 0.12em;
  color: var(--cinnabar);
  border: 1rpx solid rgba(155, 45, 36, 0.4);
  background: #fffcf5;
}
.gb-main { flex: 1; min-width: 0; }
.gb-title {
  font-weight: 700;
  letter-spacing: 0.18em;
  font-size: 32rpx;
  color: var(--ink);
}
.gb-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  letter-spacing: 0.06em;
}
.gb-go {
  font-size: 40rpx;
  color: var(--cinnabar);
  opacity: 0.75;
}
