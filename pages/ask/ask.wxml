<view
  class="page ask has-fixed-footer"
  bindtouchstart="onSwipeTouchStart"
  bindtouchend="onSwipeTouchEnd"
>
  <nav-back />
  <view class="section-head">
    <view class="title-zh ask-title-center">所求何事</view>
    <view class="ask-before-note">
      <view>占贵诚敬，一事一问；毋以戏筮，毋再三渎问。</view>
      <view>澄心定念，写下所惑，或点选常用灵感。</view>
    </view>
  </view>

  <view class="ask-custom-card">
    <view class="field-label">请输入具体事由</view>
    <textarea
      class="ask-custom-textarea"
      placeholder="请在此诚心输入您心中所惑，例如：&#10;· 近期换工作求职能否顺遂？&#10;· 本次创业投资前景如何？&#10;· 与意中人感情缘分发展怎样？"
      maxlength="120"
      value="{{question}}"
      bindinput="onInputQuestion"
    />
    <view class="ask-word-count">{{question.length || 0}}/120</view>

    <view class="ask-presets-wrap">
      <view class="ask-presets-title">✦ 常用灵感事由 ✦</view>
      <view class="ask-presets-grid">
        <view
          wx:for="{{askPresets}}"
          wx:key="*this"
          class="ask-preset-btn {{question === item ? 'active' : ''}}"
          data-text="{{item}}"
          bindtap="onSelectPreset"
        >{{item}}</view>
      </view>
    </view>
  </view>
</view>

<view class="footer-actions">
  <button class="btn-ghost half" bindtap="onBack">返回</button>
  <button class="btn-primary half" bindtap="onConfirm">{{confirmLabel}}</button>
</view>
