.section-head {
  margin-bottom: 28rpx;
}

.ask-title-center {
  text-align: center;
}

.ask-before-note {
  margin: 20rpx 0 8rpx;
  padding: 26rpx 24rpx 22rpx;
  border: 1rpx solid rgba(154, 54, 42, 0.32);
  background: rgba(168, 52, 38, 0.055);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.45);
  color: var(--ink-soft);
  text-align: center;
  font-family: inherit;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.7;
  letter-spacing: 0.08em;
}

.ask-custom-card {
  padding: 20rpx 16rpx;
  background: rgba(246, 237, 216, 0.45);
  border: 1rpx solid var(--line-strong);
  margin: 16rpx 0 22rpx;
}
.ask-custom-textarea {
  width: 100%;
  height: 160rpx;
  box-sizing: border-box;
  padding: 14rpx 16rpx;
  background: #faf6ea;
  border: 1rpx solid var(--line-strong);
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.6;
}
.ask-word-count {
  text-align: right;
  font-size: 21rpx;
  color: var(--bronze);
  margin-top: 6rpx;
}
.ask-presets-wrap {
  margin-top: 18rpx;
}
.ask-presets-title {
  font-size: 23rpx;
  letter-spacing: 0.16em;
  color: var(--bronze);
  text-align: center;
  margin-bottom: 12rpx;
}
.ask-presets-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}
.ask-preset-btn {
  width: 100%;
  box-sizing: border-box;
  padding: 13rpx 8rpx;
  font-size: 23rpx;
  line-height: 1.3;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-soft);
  background: rgba(255, 252, 246, 0.9);
  border: 1rpx solid rgba(197, 160, 89, 0.38);
  border-radius: 6rpx;
  transition: all 0.2s ease;
}
.ask-preset-btn.active {
  color: #ffffff;
  border-color: var(--cinnabar);
  background: linear-gradient(135deg, #a32c25, #851f1c);
  box-shadow: 0 4rpx 12rpx rgba(158, 42, 43, 0.25);
}

.field {
  margin-bottom: 28rpx;
}

.field-label {
  letter-spacing: 0.28em;
  font-size: 26rpx;
  color: var(--bronze);
  margin-bottom: 12rpx;
  text-align: center;
}

.ask-hint {
  font-size: 28rpx;
  letter-spacing: 0.06em;
  line-height: 1.55;
  margin-top: 18rpx;
  margin-bottom: 10rpx;
  min-height: 44rpx;
  color: var(--ink);
  text-align: center;
}

.ask-group-title {
  margin: 20rpx 0 8rpx;
  font-size: 24rpx;
  letter-spacing: 0.22em;
  color: var(--bronze);
}

.ask-category-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 20rpx;
}

.ask-category {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 16rpx 12rpx;
  border: 1rpx solid var(--line-strong);
  background: rgba(246, 237, 216, 0.5);
  text-align: center;
}

.ask-category-name {
  font-size: 28rpx;
  color: var(--ink);
  letter-spacing: 0.14em;
}

.ask-category-head {
  text-align: center;
}

.ask-category-row {
  display: flex;
  position: relative;
  justify-content: center;
  align-items: center;
  min-height: 58rpx;
  margin-top: 4rpx;
}

.ask-current-category {
  font-size: 36rpx;
  color: var(--cinnabar);
  letter-spacing: 0.14em;
}

.change-link {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  padding: 12rpx 0 12rpx 20rpx;
  color: var(--cinnabar);
  font-size: 24rpx;
  letter-spacing: 0.12em;
  white-space: nowrap;
}

.detail-label { margin-top: 26rpx; }
.time-label { margin-top: 30rpx; }

.ask-option-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 12rpx;
  align-items: stretch;
}

.ask-option {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  height: 100%;
  padding: 18rpx 16rpx;
  border: 1rpx solid var(--line-strong);
  color: var(--ink-soft);
  font-size: 25rpx;
  line-height: 1.4;
  letter-spacing: 0.01em;
  text-align: center;
  box-sizing: border-box;
  word-break: break-word;
}

.ask-option.wide {
  grid-column: 1 / -1;
}

.ask-option.on {
  color: var(--cinnabar);
  border-color: var(--cinnabar);
  background: rgba(168, 52, 38, 0.06);
}

.ask-time-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 12rpx;
}

.ask-chip {
  width: 100%;
  box-sizing: border-box;
  font-size: 24rpx;
  padding: 16rpx 8rpx;
  border: 1rpx solid var(--line-strong);
  color: var(--ink-soft);
  letter-spacing: 0.06em;
  line-height: 1.35;
  text-align: center;
}

.ask-chip.on {
  color: var(--cinnabar);
  border-color: var(--cinnabar);
  background: rgba(168, 52, 38, 0.06);
}

.btn-primary.is-disabled {
  opacity: 1;
  color: #ffffff;
  background: #9a9182;
  border-color: #8c8375;
}
