<view
  class="page interpret has-fixed-footer"
  bindtouchstart="onSwipeTouchStart"
  bindtouchend="onSwipeTouchEnd"
>
  <nav-back />
  <view class="section-head">
    <view class="title-zh">神机断卦</view>
    <view class="subtitle">深度纳甲象数 · 义理时空推演</view>
  </view>

  <!-- 加载状态 -->
  <view class="ai-loading-box" wx:if="{{loading}}">
    <view class="ai-spinner"></view>
    <view class="ai-loading-title">太史令神机研判中</view>
    <view class="ai-loading-desc">正依《{{cast.ben.name}}》卦盘研判世应动变、月令日辰与吉凶机运...</view>
    <view class="ai-loading-steps">
      <view>✓ 纳甲排盘信息已就绪</view>
      <view>✓ 用神原神忌神已标定</view>
      <view class="pulse">· 太史令正依易数推演理气机变与时空应期...</view>
    </view>
  </view>

  <!-- 结果状态：四句偈语放前面，偈语解释与卦象解释放下面 -->
  <block wx:if="{{!loading && result}}">
    <!-- 所测事宜 -->
    <view class="ask-box" wx:if="{{result.question}}">
      <view class="ask-lab">所测事宜</view>
      <view class="ask-q">{{result.question}}</view>
    </view>

    <!-- 1. 置顶第一位：趋吉避凶 · 神机四句偈 -->
    <view class="jiyu-card" wx:if="{{result.jiyu && result.jiyu.length}}">
      <view class="jiyu-head">
        <text class="jiyu-seal">✦ 趋吉避凶 · 神机四句偈 ✦</text>
      </view>
      <view class="jiyu-lines">
        <view class="jiyu-line" wx:for="{{result.jiyu}}" wx:key="*this">{{item}}</view>
      </view>
      <view class="jiyu-foot">默念受持 · 明理远虑 · 顺时趋吉</view>
    </view>

    <!-- 2. 第二位：偈语解释（针对所测事宜的具体解答与避凶指引） -->
    <view class="card-box" wx:if="{{result.jiyuExplainItems && result.jiyuExplainItems.length}}">
      <view class="card-head">
        <text class="card-badge">直断指引</text>
        <text class="card-title">偈语解释 · 趋吉避凶</text>
      </view>
      <view class="explain-list">
        <view class="explain-item" wx:for="{{result.jiyuExplainItems}}" wx:key="quote">
          <view class="explain-quote">「{{item.quote}}」</view>
          <view class="explain-text">{{item.text}}</view>
        </view>
      </view>
    </view>
    <view class="card-box" wx:elif="{{result.jiyuExplain || result.directAnswer}}">
      <view class="card-head">
        <text class="card-badge">直断指引</text>
        <text class="card-title">偈语解释 · 趋吉避凶</text>
      </view>
      <view class="card-body">{{result.jiyuExplain || result.directAnswer}}</view>
    </view>

    <!-- 3. 第三位：卦象解释（本变卦与爻动之易理精释） -->
    <view class="card-box" wx:if="{{result.guaExplain || result.judgment}}">
      <view class="card-head">
        <text class="card-badge">象数易理</text>
        <text class="card-title">卦象解释</text>
      </view>
      <view class="card-body">{{result.guaExplain || result.judgment}}</view>
    </view>

    <view class="action-row">
      <button class="btn-ghost half" bindtap="onReInterpret">重新参详</button>
      <button class="btn-ghost half" bindtap="onCopyResult">复制断语</button>
    </view>
  </block>

</view>

<view class="footer-actions" wx:if="{{!loading && result}}">
  <button class="btn-ghost half" bindtap="goResult">返回排盘</button>
  <button class="btn-primary half" bindtap="goHome">返回首页</button>
</view>

