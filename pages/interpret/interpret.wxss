.topics {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
  margin-bottom: 8rpx;
}

.topic-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--bronze);
  letter-spacing: 0.06em;
  line-height: 1.6;
}

.ask-box {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--line-strong);
  background: rgba(250, 246, 234, 0.55);
}

.ask-lab {
  font-size: 22rpx;
  letter-spacing: 0.28em;
  color: var(--bronze);
  margin-bottom: 6rpx;
}

.ask-q {
  font-size: 32rpx;
  color: var(--ink);
  letter-spacing: 0.06em;
  line-height: 1.7;
  font-weight: 600;
}

.topic {
  padding: 12rpx 18rpx;
  border: 1rpx solid var(--line-strong);
  font-size: 28rpx;
  color: var(--ink-soft);
  letter-spacing: 0.08em;
  background: transparent;
}

.topic.on {
  color: #ffffff;
  border-color: #756e64;
  background: #8d8579;
}

.verdict {
  margin: 16rpx 0 20rpx;
  padding: 28rpx 24rpx;
  border: 2rpx solid var(--line-strong);
  text-align: center;
  background: rgba(244, 234, 214, 0.65);
}

.verdict.good {
  border-color: rgba(70, 110, 75, 0.45);
}

.footer-actions {
  display: flex;
  gap: 16rpx;
  margin: 28rpx 0 20rpx;
}

.half {
  flex: 1;
}

.verdict.bad {
  border-color: rgba(158, 47, 36, 0.5);
}

.verdict .summary {
  margin: 14rpx 0 10rpx;
  font-size: 44rpx;
  letter-spacing: 0.2em;
  text-indent: 0.2em;
  color: var(--ink);
  font-weight: 600;
}

.verdict .reply {
  margin: 0 0 12rpx;
  font-size: 32rpx;
  letter-spacing: 0.08em;
  color: var(--cinnabar);
  font-weight: 600;
}

.verdict .judgment {
  margin: 0 4rpx 12rpx;
  font-size: 30rpx;
  color: var(--ink-2);
  text-align: justify;
  line-height: 1.85;
  letter-spacing: 0.04em;
}

.verdict .advice {
  margin-top: 4rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed var(--line-strong);
  font-size: 28rpx;
  color: var(--bronze);
  text-align: justify;
  line-height: 1.8;
  letter-spacing: 0.04em;
}

.section {
  padding: 8rpx 0 20rpx;
  border-top: 1rpx solid var(--line);
}

.sec-title {
  font-size: 30rpx;
  letter-spacing: 0.2em;
  margin: 18rpx 0 8rpx;
  color: var(--bronze);
}

.sec-item {
  padding: 12rpx 0;
  border-top: 1rpx dashed var(--line);
  font-size: 30rpx;
  color: var(--mist);
  text-align: justify;
  line-height: 1.8;
}

.verdict .pointer {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-left: 6rpx solid var(--cinnabar);
  background: rgba(255, 255, 255, 0.34);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.75;
  text-align: justify;
}

.verdict .pointer-label {
  margin-right: 14rpx;
  color: var(--cinnabar);
  font-weight: 600;
  letter-spacing: 0.12em;
  white-space: nowrap;
}

.verdict.auspicious {
  border-color: rgba(70, 110, 75, 0.45);
}
.verdict.inauspicious {
  border-color: rgba(158, 47, 36, 0.5);
}
.verdict.neutral {
  border-color: rgba(143, 117, 82, 0.45);
}

.ai-badge-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 16rpx 0 20rpx;
  padding: 12rpx 16rpx;
  background: rgba(246, 237, 216, 0.55);
  border: 1rpx solid var(--line);
}
.ai-badge-tag {
  color: var(--cinnabar);
  font-weight: 600;
  font-size: 24rpx;
  letter-spacing: 0.08em;
}
.ai-config-btn {
  background: transparent;
  border: 1rpx solid var(--bronze);
  color: var(--ink);
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  line-height: 1.5;
  margin: 0;
}

.ai-loading-box {
  text-align: center;
  padding: 60rpx 28rpx;
  margin: 24rpx 0;
  border: 1rpx solid var(--line-strong);
  background: rgba(246, 237, 216, 0.5);
}
.ai-spinner {
  width: 70rpx;
  height: 70rpx;
  margin: 0 auto 24rpx;
  border: 4rpx solid rgba(143, 38, 31, 0.18);
  border-top-color: var(--cinnabar);
  border-radius: 50%;
  animation: aiSpin 1s linear infinite;
}
@keyframes aiSpin {
  to { transform: rotate(360deg); }
}
.ai-loading-title {
  font-size: 34rpx;
  letter-spacing: 0.16em;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 12rpx;
}
.ai-loading-desc {
  font-size: 26rpx;
  color: var(--ink-soft);
  line-height: 1.6;
  max-width: 580rpx;
  margin: 0 auto 24rpx;
}
.ai-loading-steps {
  display: inline-flex;
  flex-direction: column;
  gap: 10rpx;
  text-align: left;
  font-size: 24rpx;
  color: var(--bronze);
}
.ai-loading-steps .pulse {
  color: var(--cinnabar);
  font-weight: 600;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0 16rpx;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 15, 12, 0.6);
  z-index: 999;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx;
  box-sizing: border-box;
}
.modal-card {
  width: 100%;
  background: #fbf7ee;
  border: 1rpx solid var(--ink);
  padding: 32rpx 28rpx;
  box-sizing: border-box;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
  color: var(--ink);
  margin-bottom: 10rpx;
  text-align: center;
}
.modal-tip {
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.5;
  margin-bottom: 24rpx;
  text-align: center;
}
.form-group {
  margin-bottom: 20rpx;
}
.form-label {
  font-size: 24rpx;
  color: var(--bronze);
  margin-bottom: 8rpx;
  display: block;
}
.form-input {
  width: 100%;
  box-sizing: border-box;
  padding: 14rpx 16rpx;
  font-size: 26rpx;
  border: 1rpx solid var(--line-strong);
  background: #faf6ea;
  color: var(--ink);
}
.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}
